local CollectionService  = game:GetService("CollectionService")
local ReplicatedStorage  = game:GetService("ReplicatedStorage")
local ServerScriptService = game:GetService("ServerScriptService")
local QuestService       = require(ServerScriptService:WaitForChild("QuestService"))

local ENEMY_TAG           = "FarmEnemy"
local SERVER_ATTACK_RANGE = 22     -- a little forgiving vs client SafeDistance
local ATTACK_COOLDOWN     = 0.35
local ATTACK_DAMAGE       = 10

local AttackRequest = ReplicatedStorage:FindFirstChild("AttackRequest")
if not AttackRequest then
    AttackRequest = Instance.new("RemoteEvent")
    AttackRequest.Name = "AttackRequest"
    AttackRequest.Parent = ReplicatedStorage
end

local function onEnemyDied(enemy)
    local killer = enemy:GetAttribute("LastAttacker")
    local enemyName = enemy:GetAttribute("EnemyName")
    if killer and enemyName then
        QuestService.RegisterKill(killer, enemyName)
    end
    task.delay(3, function()
        if enemy and enemy.Parent then enemy:Destroy() end
    end)
end

local function bindEnemy(enemy)
    local hum = enemy:FindFirstChildOfClass("Humanoid")
    if not hum then return end
    hum.Died:Connect(function() onEnemyDied(enemy) end)
end

for _, e in ipairs(CollectionService:GetTagged(ENEMY_TAG)) do bindEnemy(e) end
CollectionService:GetInstanceAddedSignal(ENEMY_TAG):Connect(bindEnemy)

-- Server-side validation: distance + tag + cooldown, so the client
-- can't just spam damage from anywhere.
AttackRequest.OnServerEvent:Connect(function(player, target)
    if typeof(target) ~= "Instance" or not target:IsA("Model") then return end
    if not CollectionService:HasTag(target, ENEMY_TAG) then return end

    local char = player.Character
    if not char then return end
    local hrp   = char:FindFirstChild("HumanoidRootPart")
    local tRoot = target:FindFirstChild("HumanoidRootPart")
    local tHum  = target:FindFirstChildOfClass("Humanoid")
    if not (hrp and tRoot and tHum) then return end
    if tHum.Health <= 0 then return end
    if (hrp.Position - tRoot.Position).Magnitude > SERVER_ATTACK_RANGE then return end

    local now  = os.clock()
    local last = player:GetAttribute("_lastAttack") or 0
    if now - last < ATTACK_COOLDOWN then return end
    player:SetAttribute("_lastAttack", now)

    target:SetAttribute("LastAttacker", player)
    tHum:TakeDamage(ATTACK_DAMAGE)
end)

-- Simple demo spawner so the loop has something to farm.
local function spawnEnemy(name, position, hp)
    local model = Instance.new("Model")
    model.Name = name
    model:SetAttribute("EnemyName", name)
    CollectionService:AddTag(model, ENEMY_TAG)

    local root = Instance.new("Part")
    root.Name = "HumanoidRootPart"
    root.Size = Vector3.new(2, 2, 1)
    root.Transparency = 1
    root.CanCollide = false
    root.Anchored = true
    root.Position = position
    root.Parent = model

    local body = Instance.new("Part")
    body.Name = "Body"
    body.Size = Vector3.new(2, 4, 1)
    body.Color = Color3.fromRGB(220, 90, 90)
    body.Material = Enum.Material.SmoothPlastic
    body.Anchored = true
    body.Position = position
    body.Parent = model

    local hum = Instance.new("Humanoid")
    hum.MaxHealth = hp
    hum.Health = hp
    hum.Parent = model

    model.PrimaryPart = root
    model.Parent = workspace
    return model
end

spawnEnemy("Bandit",           Vector3.new(0,    3, 25),  50)
spawnEnemy("Fishman Commando", Vector3.new(35,   3, 25),  80)
spawnEnemy("Fishman Lord",     Vector3.new(-35,  3, 25), 150)


