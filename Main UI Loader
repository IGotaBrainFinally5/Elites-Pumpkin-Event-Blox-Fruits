local function resolveGuiParent()
    local okPg, pg = pcall(function()
        return player:FindFirstChild("PlayerGui") or player:WaitForChild("PlayerGui", 5)
    end)
    if okPg and pg then
        warn("[EHF] Using PlayerGui as GUI parent.")
        return pg
    end
    local okCg, cg = pcall(function() return CoreGui end)
    if okCg and cg then
        warn("[EHF] Using CoreGui as GUI parent.")
        return cg
    end
    local okHui, hui = pcall(function() return gethui and gethui() end)
    if okHui and hui then
        warn("[EHF] Using gethui() as GUI parent (fallback).")
        return hui
    end
    return nil
end

