-- =========================================================
-- Respawn countdown
-- =========================================================

local function respawnStart()
    addLog("RESPAWN", "Respawn countdown started. It uses the observed 690s estimate, not a verified server timer.")
end

local function respawnTick()
    if respawnEndsAt then
        local remain = respawnEndsAt - os.clock()
        if remain > 0 then
            setFeatureStatus("respawn", string.format("Est. %02d:%02d", math.floor(remain / 60), math.floor(remain % 60)))
        else
            if not respawnNotified then
                addLog("RESPAWN", "Local 690s estimate reached. Verify actual respawn in game.")
                respawnNotified = true
            end
            setFeatureStatus("respawn", "Estimate reached")
            respawnEndsAt = nil
        end
    else
        setFeatureStatus("respawn", "waiting for pumpkin removal")
    end
end

