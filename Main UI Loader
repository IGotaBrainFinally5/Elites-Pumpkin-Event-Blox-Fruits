-- FEATURES
local features = {}
local featureOrder = {}
updateSummary = function()
    local running = 0
    for _, id in ipairs(featureOrder) do
        local f = features[id]
        if f and f.running then running = running + 1 end
    end
    if summaryStatus then
        summaryStatus.Text = string.format("%d running · %d lines · %d/s · %s", running, #logLines, pumpkinFarm.speed, pumpkinFarm.weaponCategory)
    end
end
local function setFeatureStatus(id, text)
    local f = features[id]
    if f and f.statusLabel then f.statusLabel.Text = tostring(text) end
end
local function refreshFeature(f)
    if not f then return end
    f.btn.Text = f.running and "Stop" or "Start"
    f.btn.BackgroundColor3 = f.running and THEME.ToggleOn or THEME.ToggleOff
    if f.statusLabel then f.statusLabel.TextColor3 = f.running and THEME.Green or THEME.Muted end
end
local function setFeatureRunning(id, running, silent)
    local f = features[id]
    if not f or f.running == running then return end
    f.running = running
    if running then
        if f.onStart then
            local ok, err = pcall(f.onStart)
            if not ok then addLog("ERROR", f.name .. ": " .. tostring(err)); f.running = false end
        end
    else
        if f.onStop then pcall(f.onStop) end
    end
    refreshFeature(f)
    updateSummary()
    if not silent then addLog("FEATURE", f.name .. " " .. (f.running and "started" or "stopped")) end
end
local function addFeature(id, name, desc, onStart, onStop, onTick, extraText, extraCallback)
    local row = Instance.new("Frame")
    row.Name = id
    row.Size = UDim2.new(1, -8, 0, 60)
    row.BackgroundColor3 = THEME.Panel
    row.BackgroundTransparency = 0
    row.BorderSizePixel = 1
    row.BorderColor3 = THEME.Border
    row.ZIndex = 4
    row.Parent = featureScroll
    applyCorner(row, 8)
    local t = makeLabel(row, name, UDim2.new(1, -150, 0, 18), UDim2.fromOffset(10, 5), 13, THEME.Text, true)
    t.ZIndex = 5; t.TextTruncate = Enum.TextTruncate.AtEnd
    local d = makeLabel(row, desc, UDim2.new(1, -150, 0, 16), UDim2.fromOffset(10, 23), 10, THEME.Muted, false)
    d.ZIndex = 5; d.TextTruncate = Enum.TextTruncate.AtEnd
    local s = makeLabel(row, "Stopped", UDim2.new(0, 130, 0, 14), UDim2.fromOffset(10, 42), 10, THEME.Muted, false)
    s.ZIndex = 5; s.TextTruncate = Enum.TextTruncate.AtEnd
    local btn = makeButton(row, "Start", UDim2.fromOffset(64, 28), UDim2.new(1, -74, 0, 5))
    btn.BackgroundColor3 = THEME.ToggleOff
    btn.ZIndex = 6
    if extraText then
        local eB = makeButton(row, extraText, UDim2.fromOffset(64, 22), UDim2.new(1, -74, 0, 35))
        eB.TextSize = 10; eB.ZIndex = 6
        eB.MouseButton1Click:Connect(function()
            if extraCallback then
                local ok, err = pcall(extraCallback)
                if not ok then addLog("ERROR", name .. ": " .. tostring(err)) end
            end
        end)
    end
    local f = { id = id, name = name, running = false, onStart = onStart, onStop = onStop, onTick = onTick, btn = btn, statusLabel = s, row = row }
    features[id] = f
    table.insert(featureOrder, id)
    btn.MouseButton1Click:Connect(function() setFeatureRunning(id, not f.running) end)
    featureScroll.CanvasSize = UDim2.new(0, 0, 0, #featureOrder * 66 + 8)
    return f
end

