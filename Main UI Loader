local function stopTrickOrTreat()
    trickOrTreat.running = false
    if trickOrTreat.thread then pcall(function() task.cancel(trickOrTreat.thread) end); trickOrTreat.thread = nil end
    setToTStatus("Stopped")
    addLog("TREAT", "Stopped.")
end
local function trickOrTreatStart()
    if trickOrTreat.running then return end
    trickOrTreat.running = true
    setToTStatus("Searching...")
    addLog("TREAT", "Started.")
    trickOrTreat.thread = task.spawn(function()
        while trickOrTreat.running do
            local ok, err = pcall(function()
                local char = player.Character
                local hrp = char and char:FindFirstChild("HumanoidRootPart")
                local hum = char and char:FindFirstChildOfClass("Humanoid")
                if not hrp or not hum then setToTStatus("Error: no character"); task.wait(1); return end
                if hum.PlatformStand then setToTStatus("Waiting: farm active"); task.wait(1); return end
                local doors = findTrickOrTreatDoors()
                if #doors == 0 then setToTStatus("Searching (no doors)"); task.wait(2); return end
                local best, bestDist = nil, math.huge
                for _, door in ipairs(doors) do
                    local r = door:FindFirstChild("RootPart") or door:FindFirstChild("HumanoidRootPart") or door.PrimaryPart
                    if r and r:IsA("BasePart") then
                        local d = (r.Position - hrp.Position).Magnitude
                        if d < bestDist then best, bestDist = door, d end
                    end
                end
                if not best then setToTStatus("Searching"); task.wait(2); return end
                if bestDist <= 10 then
                    setToTStatus("Interaction: " .. best.Name)
                    local prompt = best:FindFirstChildWhichIsA("ProximityPrompt", true)
                    if prompt then
                        pcall(function() prompt:InputHoldBegin() end)
                        task.wait(0.1)
                        pcall(function() prompt:InputHoldEnd() end)
                        addLog("TREAT", "Prompt on " .. best.Name)
                    else
                        local remote = findRemotePath(ReplicatedStorage, { "Remotes", "OnTalkToNPC" })
                        if remote then
                            pcall(function() remote:FireServer(best) end)
                            addLog("TREAT", "OnTalkToNPC on " .. best.Name)
                        else
                            setToTStatus("Error: no method")
                        end
                    end
                    lastTotInteractionAt = os.clock()
                    setToTStatus("Waiting")
                    task.wait(trickOrTreat.delay)
                else
                    setToTStatus(string.format("Moving: %s (%.0f)", best.Name, bestDist))
                    local r = best:FindFirstChild("RootPart") or best:FindFirstChild("HumanoidRootPart") or best.PrimaryPart
                    if r then pcall(function() hum:MoveTo(r.Position) end) end
                end
            end)
            if not ok then setToTStatus("Error: " .. tostring(err)) end
            task.wait(0.5)
        end
    end)
end

-- EVENT OBSERVER
local eventObserver = { running = false, thread = nil, connections = {}, known = {} }
local EVENT_KEYWORDS = { "trick","treat","dapper","cursed","seed","spooky","jack","pumpkin","halloween" }
local function isEventObject(inst)
    local n = inst.Name:lower()
    for _, k in ipairs(EVENT_KEYWORDS) do if n:find(k,1,true) then return true end end
    return false
end
local function handleAdded(inst)
    if not eventObserver.running then return end
    if isEventObject(inst) and not eventObserver.known[inst] then eventObserver.known[inst] = true end
end
local function handleRemoved(inst) if eventObserver.known[inst] then eventObserver.known[inst] = nil end end
local function stopEventObserver()
    eventObserver.running = false
    for _, c in ipairs(eventObserver.connections) do pcall(function() c:Disconnect() end) end
    eventObserver.connections = {}
    eventObserver.known = {}
    if eventObserver.thread then pcall(function() task.cancel(eventObserver.thread) end); eventObserver.thread = nil end
    addLog("EVENT", "Stopped.")
end
local function eventObserverStart()
    if eventObserver.running then return end
    eventObserver.running = true
    eventObserver.known = {}
    eventObserver.connections = {}
    addLog("EVENT", "Started (event-driven).")
    local containers = {}
    for _, name in ipairs({ "PumpkinHunt", "NPCs", "Halloween" }) do
        local c = Workspace:FindFirstChild(name)
        if c then table.insert(containers, c) end
    end
    for _, c in ipairs(containers) do
        table.insert(eventObserver.connections, c.DescendantAdded:Connect(handleAdded))
        table.insert(eventObserver.connections, c.DescendantRemoved:Connect(handleRemoved))
    end
    for _, c in ipairs(containers) do
        local ok, desc = pcall(function() return c:GetDescendants() end)
        if ok then for _, d in ipairs(desc) do if isEventObject(d) then eventObserver.known[d] = true end end end
    end
    eventObserver.thread = task.spawn(function()
        while eventObserver.running do
            task.wait(CONFIG.EVENT_SCAN_INTERVAL)
            local n = 0
            for _ in pairs(eventObserver.known) do n = n + 1 end
            setFeatureStatus("events", tostring(n) .. " tracked")
        end
    end)
end

-- MATERIAL SCANNER
local MATERIAL_KEYWORDS = { "candy","corn","pumpkin","bit","seed","treat","halloween","spooky","soul","bone" }
local function hasMatKeyword(name)
    local s = tostring(name):lower()
    for _, k in ipairs(MATERIAL_KEYWORDS) do if s:find(k,1,true) then return true end end
    return false
end
local function collectMaterials()
    local out = {}
    local function add(n, v) if hasMatKeyword(n) and type(v) == "number" then out[n] = v end end
    for k, v in pairs(player:GetAttributes()) do add("attr." .. tostring(k), v) end
    local ls = player:FindFirstChild("leaderstats")
    if ls then for _, c in ipairs(ls:GetChildren()) do if c:IsA("ValueBase") then add("leaderstats." .. c.Name, c.Value) end end end
    for _, cont in ipairs({ player:FindFirstChild("Backpack"), player.Character }) do
        if cont then
            for _, ch in ipairs(cont:GetChildren()) do
                if ch:IsA("Tool") and hasMatKeyword(ch.Name) then
                    local key = "tool." .. ch.Name
                    out[key] = (out[key] or 0) + 1
                end
            end
        end
    end
    return out
end
local function matString(t)
    local ks = {}
    for k in pairs(t) do table.insert(ks, k) end
    table.sort(ks)
    local p = {}
    for _, k in ipairs(ks) do table.insert(p, k .. "=" .. tostring(t[k])) end
    return table.concat(p, ", ")
end
local matSnapshot = nil
local function matStart() matSnapshot = nil; addLog("MATERIAL", "Started.") end
local function matTick()
    local s = collectMaterials()
    local str = matString(s)
    if not matSnapshot then addLog("MATERIAL", "Initial: " .. (str ~= "" and str or "none")); matSnapshot = s
    elseif matString(matSnapshot) ~= str then addLog("MATERIAL", "Change: " .. (str ~= "" and str or "none")); matSnapshot = s end
    local n = 0
    for _ in pairs(s) do n = n + 1 end
    setFeatureStatus("materials", tostring(n) .. " value(s)")
end

