-- LOGGING
local function timestamp()
    local ok, res = pcall(function() return os.date("%H:%M:%S") end)
    if ok and res then return res end
    return string.format("%.1f", os.clock())
end
local function fmt(v)
    if type(v) == "table" then
        local ok, res = pcall(function() return HttpService:JSONEncode(v) end)
        return ok and res or tostring(v)
    end
    return tostring(v)
end

local logEnabled = true
local logLines = {}
local logLabel, logScroll, summaryStatus
local updateSummary

local function addLog(tag, msg)
    if not logEnabled and tag ~= "SYS" and tag ~= "ERROR" then return end
    local line = string.format("%s [%s] %s", timestamp(), tostring(tag), tostring(msg))
    table.insert(logLines, line)
    while #logLines > CONFIG.MAX_LOG_LINES do table.remove(logLines, 1) end
    if logLabel then
        logLabel.Text = table.concat(logLines, "\n")
        if logScroll then
            local b = 0
            local ok, v = pcall(function() return logLabel.TextBounds.Y end)
            if ok and type(v) == "number" and v > 0 then b = v else b = #logLines * 16 end
            logScroll.CanvasSize = UDim2.new(0, 0, 0, math.max(b + 16, 32))
        end
    end
    if updateSummary then updateSummary() end
end

