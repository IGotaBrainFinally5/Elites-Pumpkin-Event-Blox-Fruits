local function timestamp()
    local ok, res = pcall(function()
        return os.date("%H:%M:%S")
    end)
    if ok and res then
        return res
    end
    return string.format("%.1f", os.clock())
end

local function fmt(v)
    if type(v) == "table" then
        local ok, res = pcall(function()
            return HttpService:JSONEncode(v)
        end)
        return ok and res or tostring(v)
    end
    return tostring(v)
end

local logEnabled = true
local logLines = {}
local logLabel
local logScroll
local summaryStatus
local updateSummary

local function addLog(tag, msg)
    if not logEnabled and tag ~= "SYS" and tag ~= "ERROR" then
        return
    end
    local line = string.format("%s [%s] %s", timestamp(), tostring(tag), tostring(msg))
    table.insert(logLines, line)
    while #logLines > CONFIG.MAX_LOG_LINES do
        table.remove(logLines, 1)
    end
    if logLabel then
        logLabel.Text = table.concat(logLines, "\n")
        if logScroll then
            local bounds = 0
            local ok, b = pcall(function()
                return logLabel.TextBounds.Y
            end)
            if ok and type(b) == "number" and b > 0 then
                bounds = b
            else
                bounds = #logLines * 16
            end
            logScroll.CanvasSize = UDim2.new(0, 0, 0, math.max(bounds + 16, 32))
        end
    end
    if updateSummary then
        updateSummary()
    end
end

local function applyCorner(frame, radius)
    pcall(function()
        local c = Instance.new("UICorner")
        c.CornerRadius = UDim2.fromOffset(radius, radius)
        c.Parent = frame
    end)
end

local function makeFrame(parent, color, size, pos, name)
    local f = Instance.new("Frame")
    if name then
        f.Name = name
    end
    f.BackgroundColor3 = color or THEME.Panel
    f.BackgroundTransparency = 0
    f.BorderSizePixel = 1
    f.BorderColor3 = THEME.Border
    f.Visible = true
    f.Size = size
    f.Position = pos
    f.Parent = parent
    applyCorner(f, 8)
    return f
end

local function makeLabel(parent, text, size, pos, textSize, color, bold)
    local l = Instance.new("TextLabel")
    l.BackgroundTransparency = 1
    l.BorderSizePixel = 0
    l.Text = text
    l.TextColor3 = color or THEME.Text
    l.TextSize = textSize or 14
    l.Font = bold and FONT_BOLD or FONT_REG
    l.TextXAlignment = Enum.TextXAlignment.Left
    l.TextYAlignment = Enum.TextYAlignment.Top
    l.Visible = true
    l.Size = size
    l.Position = pos
    l.Parent = parent
    return l
end

local function makeButton(parent, text, size, pos)
