    { "Modules", "Net", "RE/RegisterAttack" },
}
local diagLast = 0
local function runDiagnostics(verbose)
    local present = 0
    for _, path in ipairs(DIAG_PATHS) do
        local obj = findRemotePath(ReplicatedStorage, path)
        local name = table.concat(path, ".")
        if obj then
            present = present + 1
            if verbose then addLog("DIAG", "FOUND " .. name .. " (" .. obj.ClassName .. ")") end
        elseif verbose then addLog("DIAG", "MISSING " .. name) end
    end
    setFeatureStatus("diag", tostring(present) .. "/" .. tostring(#DIAG_PATHS))
end
local function diagStart() diagLast = 0; addLog("DIAG", "Started."); runDiagnostics(true) end
local function diagTick()
    if os.clock() - diagLast < 15 then return end
    diagLast = os.clock()
    runDiagnostics(false)
end

-- =========================================================
-- NPC THREAT DETECTION (diagnostic only)
-- =========================================================
local npcLastIds = {}
local function npcScanStart()
    addLog("NPC", "Started. Diagnostic only — no auto-attack. Blox Fruits NPCs are mostly passive.")
    npcLastIds = {}
end
local function npcScanStop()
    addLog("NPC", "Stopped.")
    npcLastIds = {}
end
local function npcScanTick()
    if os.clock() - npcLastScan < CONFIG.NPC_SCAN_INTERVAL then return end
    npcLastScan = os.clock()
    local char = player.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not hrp then setFeatureStatus("npc", "no character"); return end

    local roots = {}
    local npcsFolder = Workspace:FindFirstChild("NPCs")
    if npcsFolder then table.insert(roots, npcsFolder) end

    local found = {}
    for _, root in ipairs(roots) do
        local ok, desc = pcall(function() return root:GetDescendants() end)
        if ok then
            for _, d in ipairs(desc) do
                if d:IsA("Model") then
                    local h = d:FindFirstChildOfClass("Humanoid")
                    local r = d:FindFirstChild("HumanoidRootPart") or d.PrimaryPart
                    if h and r and r:IsA("BasePart") then
                        local dist = (r.Position - hrp.Position).Magnitude
                        if dist <= CONFIG.NPC_SCAN_RADIUS then
                            found[d] = { name = d.Name, dist = dist }
                        end
                    end
                end
            end
        end
    end
    for obj, info in pairs(found) do
        if not npcLastIds[obj] then
            npcLastIds[obj] = true
            addLog("NPC", string.format("%s @ %.0f studs", info.name, info.dist))
        end
    end
    for obj in pairs(npcLastIds) do
        if not found[obj] then npcLastIds[obj] = nil end
    end
    local n = 0
    for _ in pairs(found) do n = n + 1 end
    setFeatureStatus("npc", tostring(n) .. " nearby")
end

