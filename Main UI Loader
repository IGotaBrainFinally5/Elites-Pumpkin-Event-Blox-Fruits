local QuestConfig = {}

QuestConfig.Quests = {
    { Id = "Q1", Level = 1,  EnemyName = "Bandit",            Count = 5,  Reward = 100 },
    { Id = "Q2", Level = 5,  EnemyName = "Fishman Commando",  Count = 8,  Reward = 250 },
    { Id = "Q3", Level = 10, EnemyName = "Fishman Lord",      Count = 10, Reward = 500 },
}

-- Highest-level quest the player qualifies for.
function QuestConfig.GetBestQuestForLevel(level)
    local best = nil
    for _, q in ipairs(QuestConfig.Quests) do
        if q.Level <= level and (not best or q.Level > best.Level) then
            best = q
        end
    end
    return best
end

return QuestConfig


