-- =========================================================
-- WATER / SAFE-Y HELPERS
-- =========================================================
-- Downward raycast at (x, z). Returns waterY if hit is water/terrain-water or a part named water/ocean.
-- Returns nil if ray missed everything.
local function getWaterHeightAt(x, z)
    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    local char = player.Character
    if char then params.FilterDescendantsInstances = { char } end
    params.IgnoreWater = false
    params.RespectCanCollide = false

    local origin = Vector3.new(x, 2000, z)
    local dir = Vector3.new(0, -4000, 0)
    local ok, result = pcall(function() return Workspace:Raycast(origin, dir, params) end)
    if not ok or not result then return nil end

    local inst = result.Instance
    local mat = result.Material
    local isWater = (mat == Enum.Material.Water)
    if not isWater and inst then
        local n = inst.Name:lower()
        if n:find("water", 1, true) or n:find("ocean", 1, true) then
            isWater = true
        end
    end
    if isWater then
        return result.Position.Y
    end
    -- Return ground Y so caller can still avoid clipping into terrain
    return nil, result.Position.Y
end

-- Compute a safe destination vector (X,Z unchanged, Y clamped above water/ground)
local function computeSafeFlyTarget(targetPos)
    local waterY, groundY = getWaterHeightAt(targetPos.X, targetPos.Z)
    local safeY = targetPos.Y

    if waterY then
        local minY = waterY + CONFIG.MIN_HEIGHT_ABOVE_WATER
        if safeY < minY then safeY = minY end
    elseif groundY then
        local minY = groundY + 3
        if safeY < minY then safeY = minY end
    end
    return Vector3.new(targetPos.X, safeY, targetPos.Z), waterY
end

-- =========================================================
-- WEAPON HELPERS
-- =========================================================
local MELEE_STYLES = {
    "combat", "dark step", "electric", "water kung fu",
    "dragon breath", "superhuman", "death step",
    "sharkman karate", "electric claw", "dragon talon",
    "godhuman", "sanguine art",
}

local function isMeleeStyle(name)
    local n = tostring(name):lower()
    for _, s in ipairs(MELEE_STYLES) do
        if n:find(s, 1, true) then return true end
    end
    return false
end

local function looksLikeFruitTool(name)
    -- Blox Fruits fruit tools usually "X-X" or "X X" patterns; treat hyphens as fruit markers
    return tostring(name):find("%-") ~= nil
end

local function getEquippedFightingStyle()
    local char = player.Character
    if not char then return "Combat" end
    local tool = char:FindFirstChildOfClass("Tool")
    if tool and isMeleeStyle(tool.Name) then return tool.Name end
    return "Combat"
end

-- Attempt to equip a tool matching the selected category.
-- Returns the equipped tool, or nil if none found.
local function equipWeaponOfCategory(category)
    local char = player.Character
    if not char then return nil end
    local humanoid = char:FindFirstChildOfClass("Humanoid")
    if not humanoid then return nil end

    local current = char:FindFirstChildOfClass("Tool")
    if current then
        local isMelee = isMeleeStyle(current.Name)
        if (category == "Melee" and isMelee) or (category == "Sword" and not isMelee and not looksLikeFruitTool(current.Name)) then
            return current
        end
    end

    local backpack = player:FindFirstChild("Backpack")
    if not backpack then return nil end

    for _, tool in ipairs(backpack:GetChildren()) do
        if tool:IsA("Tool") then
            local isMelee = isMeleeStyle(tool.Name)
            local isFruit = looksLikeFruitTool(tool.Name)
            local match = false
            if category == "Melee" then
                match = isMelee
            elseif category == "Sword" then
                match = (not isMelee) and (not isFruit)
            end
            if match then
                pcall(function() humanoid:EquipTool(tool) end)
                return tool
            end
        end
    end
    return nil
end

-- =========================================================
-- PUMPKIN DETECTION (map-wide via PumpkinHunt, skips blacklisted)
-- =========================================================
local function findClosestPumpkin()
    local hunt = Workspace:FindFirstChild("PumpkinHunt")
    if not hunt then return nil, nil end
    local char = player.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not hrp then return nil, nil end

    local now = os.clock()
    local best, bestDist, bestRoot = nil, math.huge, nil
    local ok, descendants = pcall(function() return hunt:GetDescendants() end)
    if not ok then return nil, nil end

    for _, d in ipairs(descendants) do
        if d:IsA("Model") and d.Parent and d.Name:lower():find("pumpkin", 1, true) then
            local bl = pumpkinFarm.blacklist[d]
            if not (bl and bl > now) then
                local root = d:FindFirstChild("RootPart") or d:FindFirstChild("HumanoidRootPart")
                if root and root:IsA("BasePart") and root.Parent then
                    local dist = (root.Position - hrp.Position).Magnitude
                    if dist < bestDist then
                        best, bestDist, bestRoot = d, dist, root
                    end
                end
            end
        end
    end
    return best, bestRoot
end

local function fireRegisterAttack()
    local remote = getRegisterAttack()
    if not remote then return false end
    return (pcall(function() remote:FireServer(0.4000000059604645, 1) end))
end

local function fireRegisterHit(rootPart)
    local remote = getRegisterHit()
    if not remote or not rootPart then return false end
    return (pcall(function() remote:FireServer(rootPart) end))
end

-- =========================================================
-- RENDER LOOP: fly movement + water safety + auto noclip
-- =========================================================
RunService.RenderStepped:Connect(function(dt)
    if not pumpkinFarm.running then return end

    local char = player.Character
    if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hrp or not hum then return end

    -- Character changed (respawn)
    if hum ~= pumpkinFarm.lastHumanoid then
        pumpkinFarm.lastHumanoid = hum
        noclipParts = {}
        pumpkinFarm.flyTarget = nil
        pumpkinFarm.currentPumpkin = nil
        pumpkinFarm.currentRoot = nil
        pumpkinFarm.targetWaterY = nil
        pumpkinFarm.stuckTime = 0
        pumpkinFarm.lastDistance = nil
        pumpkinFarm.lastY = nil
        pumpkinFarm.lastDy = nil
        pumpkinFarm.oscillationCount = 0
        pumpkinFarm.weaponEquippedFor = nil
        pcall(function() hum.PlatformStand = true end)
    end

    -- Auto noclip
    for _, part in ipairs(char:GetChildren()) do
        if part:IsA("BasePart") and part.CanCollide then
            part.CanCollide = false
            noclipParts[part] = true
        end
    end

    -- Fly movement
    if pumpkinFarm.flyTarget then
        local offset = pumpkinFarm.flyTarget - hrp.Position
        local dist = offset.Magnitude
        if dist < 0.5 then
            pumpkinFarm.flyTarget = nil
        else
            local step = math.min(dist, pumpkinFarm.speed * dt)
            hrp.CFrame = hrp.CFrame + offset.Unit * step
        end

        -- Periodic water safety: if somehow we end up underwater mid-flight, lift
        if os.clock() - pumpkinFarm.lastWaterCheck > CONFIG.WATER_CHECK_INTERVAL then
            pumpkinFarm.lastWaterCheck = os.clock()
            local waterY = getWaterHeightAt(hrp.Position.X, hrp.Position.Z)
            if waterY and hrp.Position.Y < waterY + CONFIG.MIN_HEIGHT_ABOVE_WATER then
                local liftTo = waterY + CONFIG.MIN_HEIGHT_ABOVE_WATER + 1
                hrp.CFrame = CFrame.new(hrp.Position.X, liftTo, hrp.Position.Z) * (hrp.CFrame - hrp.CFrame.Position)
                if pumpkinFarm.flyTarget then
                    pumpkinFarm.flyTarget = Vector3.new(pumpkinFarm.flyTarget.X, math.max(pumpkinFarm.flyTarget.Y, liftTo), pumpkinFarm.flyTarget.Z)
                end
            end
        end
    end
end)

-- =========================================================
-- PUMPKIN FARM TICK (state machine)
-- =========================================================
local function resetStuckTracking()
    pumpkinFarm.stuckTime = 0
    pumpkinFarm.lastDistance = nil
    pumpkinFarm.lastY = nil
    pumpkinFarm.lastDy = nil
    pumpkinFarm.oscillationCount = 0
end

local function blacklistTarget(reason)
    local p = pumpkinFarm.currentPumpkin
    if p then
        pumpkinFarm.blacklist[p] = os.clock() + CONFIG.BLACKLIST_DURATION
        addLog("PUMPKIN", string.format("Blacklisting %s for %ds (%s)", tostring(p.Name), CONFIG.BLACKLIST_DURATION, reason))
    end
    pumpkinFarm.currentPumpkin = nil
    pumpkinFarm.currentRoot = nil
    pumpkinFarm.flyTarget = nil
    pumpkinFarm.targetWaterY = nil
    pumpkinFarm.weaponEquippedFor = nil
    resetStuckTracking()
end

local function pumpkinFarmTick()
    local char = player.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not hrp then
        setFeatureStatus("pumpkin", "no character")
        return
    end

    -- Prune expired blacklist entries occasionally
    if math.random() < 0.05 then
        local now = os.clock()
        for k, v in pairs(pumpkinFarm.blacklist) do
            if v < now or not k.Parent then
                pumpkinFarm.blacklist[k] = nil
            end
        end
    end

    -- Validate target
    if pumpkinFarm.currentPumpkin then
        local p = pumpkinFarm.currentPumpkin
        local r = pumpkinFarm.currentRoot
        if not p.Parent or not r or not r.Parent then
            addLog("PUMPKIN", "Target gone: " .. tostring(p.Name))
            pumpkinFarm.currentPumpkin = nil
            pumpkinFarm.currentRoot = nil
            pumpkinFarm.flyTarget = nil
            pumpkinFarm.targetWaterY = nil
            pumpkinFarm.weaponEquippedFor = nil
            resetStuckTracking()
        end
    end

    -- Acquire target if none
    if not pumpkinFarm.currentPumpkin then
        if pumpkinFarm.state == "WAITING" and pumpkinFarm.lastRespawnAt then
            local remain = CONFIG.PUMPKIN_RESPAWN - (os.clock() - pumpkinFarm.lastRespawnAt)
            local sinceCheck = os.clock() - pumpkinFarm.lastWaitScanTime
            if remain > 0 and sinceCheck < CONFIG.WAITING_RESCAN then
                setFeatureStatus("pumpkin", string.format("waiting (est. %02d:%02d)", math.floor(remain/60), math.floor(remain%60)))
                return
            end
            pumpkinFarm.lastWaitScanTime = os.clock()
        end

        local p, r = findClosestPumpkin()
        if p and r then
            pumpkinFarm.currentPumpkin = p
            pumpkinFarm.currentRoot = r
            pumpkinFarm.state = "MOVING"
            local safePos, waterY = computeSafeFlyTarget(r.Position)
            pumpkinFarm.flyTarget = safePos
            pumpkinFarm.targetWaterY = waterY
            pumpkinFarm.lastRespawnAt = nil
            pumpkinFarm.weaponEquippedFor = nil
            resetStuckTracking()
            addLog("PUMPKIN", "Targeting " .. p.Name)
        else
            if pumpkinFarm.state ~= "WAITING" then
                pumpkinFarm.state = "WAITING"
                pumpkinFarm.lastRespawnAt = os.clock()
                pumpkinFarm.lastWaitScanTime = os.clock()
                addLog("PUMPKIN", "No pumpkins available. Waiting for respawn.")
            end
            pumpkinFarm.flyTarget = nil
            pumpkinFarm.targetWaterY = nil
            setFeatureStatus("pumpkin", "no pumpkins")
            return
        end
    end

    local root = pumpkinFarm.currentRoot
    local pumpkin = pumpkinFarm.currentPumpkin
    if not root or not pumpkin then return end

    -- Progress tracking for stuck detection
    local dist = (root.Position - hrp.Position).Magnitude
    if pumpkinFarm.lastDistance then
        local delta = pumpkinFarm.lastDistance - dist
        if delta < CONFIG.PROGRESS_THRESHOLD then
            pumpkinFarm.stuckTime = pumpkinFarm.stuckTime + CONFIG.STUCK_TICK_DT
        else
            pumpkinFarm.stuckTime = 0
        end
    end
    pumpkinFarm.lastDistance = dist

    -- Vertical oscillation detection
    if pumpkinFarm.lastY then
        local dy = hrp.Position.Y - pumpkinFarm.lastY
        if pumpkinFarm.lastDy and math.abs(dy) > 0.1 and math.abs(pumpkinFarm.lastDy) > 0.1 then
            if (dy > 0) ~= (pumpkinFarm.lastDy > 0) then
                pumpkinFarm.oscillationCount = pumpkinFarm.oscillationCount + 1
            end
        end
        pumpkinFarm.lastDy = dy
    end
    pumpkinFarm.lastY = hrp.Position.Y

    -- Trigger stuck recovery
    if pumpkinFarm.stuckTime >= CONFIG.STUCK_TIMEOUT then
        blacklistTarget(string.format("no progress %.1fs", pumpkinFarm.stuckTime))
        return
    end
    if pumpkinFarm.oscillationCount >= CONFIG.OSCILLATION_THRESHOLD then
        blacklistTarget(string.format("Y-oscillation x%d", pumpkinFarm.oscillationCount))
        return
    end

    if dist > CONFIG.TOUCH_DISTANCE then
        if not pumpkinFarm.flyTarget then
            local safePos, waterY = computeSafeFlyTarget(root.Position)
            pumpkinFarm.flyTarget = safePos
            pumpkinFarm.targetWaterY = waterY
        end
        pumpkinFarm.state = "MOVING"
        setFeatureStatus("pumpkin", string.format("flying %.0f studs @ %d/s", dist, pumpkinFarm.speed))
    else
        pumpkinFarm.flyTarget = nil
        pumpkinFarm.state = "ATTACKING"

        -- Equip appropriate weapon once per target
        if pumpkinFarm.weaponEquippedFor ~= pumpkin then
            local equipped = equipWeaponOfCategory(pumpkinFarm.weaponCategory)
            pumpkinFarm.weaponEquippedFor = pumpkin
            if equipped then
                addLog("WEAPON", "Equipped for attack: " .. equipped.Name .. " (" .. pumpkinFarm.weaponCategory .. ")")
            else
                addLog("WEAPON", "No tool found matching category " .. pumpkinFarm.weaponCategory .. "; keeping current.")
            end
        end

        local currentTool = char and char:FindFirstChildOfClass("Tool")
        local style = currentTool and currentTool.Name or "Combat"
        setFeatureStatus("pumpkin", "attacking " .. pumpkin.Name .. " (" .. style .. ")")

        pcall(function()
            hrp.CFrame = CFrame.lookAt(hrp.Position, Vector3.new(root.Position.X, hrp.Position.Y, root.Position.Z))
        end)

        if os.clock() - pumpkinFarm.lastAttackTime >= CONFIG.ATTACK_COOLDOWN then
            pumpkinFarm.lastAttackTime = os.clock()
            local aOk = fireRegisterAttack()
            local hOk = fireRegisterHit(root)
            if not aOk and not hOk then
                addLog("PUMPKIN", "Attack remotes unavailable — cannot damage.")
                setFeatureStatus("pumpkin", "attack remotes missing")
            end
        end
    end
end

local function pumpkinFarmStart()
    if pumpkinFarm.running then return end
    pumpkinFarm.running = true
    pumpkinFarm.state = "IDLE"
    pumpkinFarm.currentPumpkin = nil
    pumpkinFarm.currentRoot = nil
    pumpkinFarm.flyTarget = nil
    pumpkinFarm.targetWaterY = nil
    pumpkinFarm.lastRespawnAt = nil
    pumpkinFarm.lastWaitScanTime = 0
    pumpkinFarm.lastAttackTime = 0
    pumpkinFarm.lastHumanoid = nil
    pumpkinFarm.lastWaterCheck = 0
    pumpkinFarm.weaponEquippedFor = nil
    resetStuckTracking()
    noclipParts = {}

    addLog("PUMPKIN", string.format("Started. Fly %d/s, weapon %s, auto-noclip ON, water-safe ON.", pumpkinFarm.speed, pumpkinFarm.weaponCategory))
    pumpkinFarm.thread = task.spawn(function()
        while pumpkinFarm.running do
            pcall(pumpkinFarmTick)
            task.wait(0.1)
        end
    end)
end

local function stopPumpkinFarm()
    pumpkinFarm.running = false
    if pumpkinFarm.thread then
        pcall(function() task.cancel(pumpkinFarm.thread) end)
        pumpkinFarm.thread = nil
    end
    pumpkinFarm.flyTarget = nil
    pumpkinFarm.currentPumpkin = nil
    pumpkinFarm.currentRoot = nil
    pumpkinFarm.targetWaterY = nil
    pumpkinFarm.state = "IDLE"
    pumpkinFarm.lastRespawnAt = nil
    pumpkinFarm.weaponEquippedFor = nil
    resetStuckTracking()

    for part in pairs(noclipParts) do
        pcall(function()
            if part.Parent and part:IsA("BasePart") then
                part.CanCollide = true
            end
        end)
    end
    noclipParts = {}

    local char = player.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    if hum then
        pcall(function() hum.PlatformStand = false end)
    end
    pumpkinFarm.lastHumanoid = nil

    addLog("PUMPKIN", "Stopped. Noclip OFF.")
end

-- =========================================================
-- AUTO TRICK OR TREAT (with diagnostics)
-- =========================================================
local trickOrTreat = {
    running = false,
    thread = nil,
    delay = 1.5,
    lastDoor = nil,
}

local function setToTStatus(text)
    setFeatureStatus("treat", text)
end

local function findTrickOrTreatDoors()
    local doors = {}
    local candidateRoots = {}
    for _, name in ipairs({ "Halloween", "NPCs", "PumpkinHunt" }) do
        local r = Workspace:FindFirstChild(name)
        if r then table.insert(candidateRoots, r) end
    end
    for _, child in ipairs(Workspace:GetChildren()) do
        if child:IsA("Model") and (child.Name:lower():find("door", 1, true) or child.Name:lower():find("trick", 1, true)) then
            table.insert(doors, child)
        end
    end
    for _, root in ipairs(candidateRoots) do
        local ok, descendants = pcall(function() return root:GetDescendants() end)
        if ok then
            for _, d in ipairs(descendants) do
                if d:IsA("Model") and (d.Name:lower():find("door", 1, true) or d.Name:lower():find("trick", 1, true) or d.Name:lower():find("treat", 1, true)) then
                    table.insert(doors, d)
                end
            end
        end
    end
    return doors
end

local function stopTrickOrTreat()
    trickOrTreat.running = false
    if trickOrTreat.thread then
        pcall(function() task.cancel(trickOrTreat.thread) end)
        trickOrTreat.thread = nil
    end
    setToTStatus("Stopped")
    addLog("TREAT", "Auto Trick or Treat stopped.")
end

local function trickOrTreatStart()
    if trickOrTreat.running then return end
    trickOrTreat.running = true
    setToTStatus("Searching...")
    addLog("TREAT", "Auto Trick or Treat started. Best-effort: searches door models, uses ProximityPrompt or OnTalkToNPC.")
    trickOrTreat.thread = task.spawn(function()
        while trickOrTreat.running do
            local ok, err = pcall(function()
                local char = player.Character
                local hrp = char and char:FindFirstChild("HumanoidRootPart")
                local hum = char and char:FindFirstChildOfClass("Humanoid")

                if not hrp or not hum then
                    setToTStatus("Error: no character")
                    task.wait(1)
                    return
                end

                -- If pumpkin farm has PlatformStand on, MoveTo won't work
                if hum.PlatformStand then
                    setToTStatus("Waiting: movement disabled by other feature")
                    task.wait(1)
                    return
                end

                setToTStatus("Searching...")
                local doors = findTrickOrTreatDoors()
                if #doors == 0 then
                    setToTStatus("Searching (no doors found)")
                    task.wait(2)
                    return
                end

                local best, bestDist = nil, math.huge
                for _, door in ipairs(doors) do
                    local root = door:FindFirstChild("RootPart") or door:FindFirstChild("HumanoidRootPart") or door.PrimaryPart
                    if root and root:IsA("BasePart") then
                        local dist = (root.Position - hrp.Position).Magnitude
                        if dist < bestDist then best, bestDist = door, dist end
                    end
                end

                if not best then
                    setToTStatus("Searching (doors have no RootPart)")
                    task.wait(2)
                    return
                end

                if bestDist <= 10 then
                    setToTStatus("Interaction attempted: " .. best.Name)
                    local prompt = best:FindFirstChildWhichIsA("ProximityPrompt", true)
                    if prompt then
                        pcall(function() prompt:InputHoldBegin() end)
                        task.wait(0.1)
                        pcall(function() prompt:InputHoldEnd() end)
                        addLog("TREAT", "ProximityPrompt on " .. best.Name)
                    else
                        local remote = findRemotePath(ReplicatedStorage, { "Remotes", "OnTalkToNPC" })
                        if remote then
                            pcall(function() remote:FireServer(best) end)
                            addLog("TREAT", "OnTalkToNPC on " .. best.Name)
                        else
                            addLog("TREAT", "No interaction method for " .. best.Name)
                            setToTStatus("Error: no interaction method")
                        end
                    end
                    setToTStatus("Waiting (cooldown)")
                    task.wait(trickOrTreat.delay)
                else
                    setToTStatus(string.format("Target found: %s (%.0f studs)", best.Name, bestDist))
                    local root = best:FindFirstChild("RootPart") or best:FindFirstChild("HumanoidRootPart") or best.PrimaryPart
                    if root then
                        pcall(function() hum:MoveTo(root.Position) end)
                    end
                end
            end)
            if not ok then
                setToTStatus("Error: " .. tostring(err))
                addLog("ERROR", "Trick or Treat tick: " .. tostring(err))
            end
            task.wait(0.5)
        end
    end)
end

-- =========================================================
-- EVENT KEYWORD OBSERVER (event-driven)
-- =========================================================
local eventObserver = {
    running = false,
    thread = nil,
    connections = {},
    knownObjects = {},
}

local EVENT_KEYWORDS = { "trick", "treat", "dapper", "cursed", "seed", "spooky", "jack", "pumpkin", "halloween" }

local function isEventObject(inst)
    local n = inst.Name:lower()
    for _, k in ipairs(EVENT_KEYWORDS) do
        if n:find(k, 1, true) then return true end
    end
    return false
end

local function handleAdded(inst)
    if not eventObserver.running then return end
    if isEventObject(inst) and not eventObserver.knownObjects[inst] then
        eventObserver.knownObjects[inst] = true
        addLog("EVENT", "Added: " .. inst.ClassName .. ":" .. inst.Name)
    end
end

local function handleRemoved(inst)
    if eventObserver.knownObjects[inst] then
        eventObserver.knownObjects[inst] = nil
        addLog("EVENT", "Removed: " .. inst.ClassName .. ":" .. inst.Name)
    end
end

local function stopEventObserver()
    eventObserver.running = false
    for _, c in ipairs(eventObserver.connections) do
        pcall(function() c:Disconnect() end)
    end
    eventObserver.connections = {}
    eventObserver.knownObjects = {}
    if eventObserver.thread then
        pcall(function() task.cancel(eventObserver.thread) end)
        eventObserver.thread = nil
    end
    addLog("EVENT", "Event Keyword Observer stopped.")
end

local function eventObserverStart()
    if eventObserver.running then return end
    eventObserver.running = true
    eventObserver.knownObjects = {}
    eventObserver.connections = {}
    addLog("EVENT", "Event Keyword Observer started (event-driven).")

    local containers = {}
    for _, name in ipairs({ "PumpkinHunt", "NPCs", "Halloween" }) do
        local c = Workspace:FindFirstChild(name)
        if c then table.insert(containers, c) end
    end
    if #containers == 0 then
        addLog("EVENT", "No known event containers found.")
        setFeatureStatus("events", "no containers")
    else
        for _, c in ipairs(containers) do
            table.insert(eventObserver.connections, c.DescendantAdded:Connect(handleAdded))
            table.insert(eventObserver.connections, c.DescendantRemoved:Connect(handleRemoved))
        end
        for _, c in ipairs(containers) do
            local ok, descendants = pcall(function() return c:GetDescendants() end)
            if ok then
                for _, d in ipairs(descendants) do
                    if isEventObject(d) then eventObserver.knownObjects[d] = true end
                end
            end
        end
        addLog("EVENT", "Connected to " .. #containers .. " container(s).")
    end

    eventObserver.thread = task.spawn(function()
        while eventObserver.running do
            task.wait(CONFIG.EVENT_SCAN_INTERVAL)
            local count = 0
            for _ in pairs(eventObserver.knownObjects) do count = count + 1 end
            setFeatureStatus("events", tostring(count) .. " tracked")
        end
    end)
end

-- =========================================================
-- MATERIAL SCANNER
-- =========================================================
local MATERIAL_KEYWORDS = { "candy", "corn", "pumpkin", "bit", "seed", "treat", "halloween", "spooky", "soul", "bone" }

local function hasMaterialKeyword(name)
    local s = tostring(name):lower()
    for _, k in ipairs(MATERIAL_KEYWORDS) do
        if s:find(k, 1, true) then return true end
    end
    return false
end

local function collectMaterials()
    local out = {}
    local function add(name, value)
        if hasMaterialKeyword(name) and type(value) == "number" then out[name] = value end
    end
    for k, v in pairs(player:GetAttributes()) do add("attr." .. tostring(k), v) end
    local leaderstats = player:FindFirstChild("leaderstats")
    if leaderstats then
        for _, c in ipairs(leaderstats:GetChildren()) do
            if c:IsA("ValueBase") then add("leaderstats." .. c.Name, c.Value) end
        end
    end
    for _, cont in ipairs({ player:FindFirstChild("Backpack"), player.Character }) do
        if cont then
            for _, child in ipairs(cont:GetChildren()) do
                if child:IsA("Tool") and hasMaterialKeyword(child.Name) then
                    local key = "tool." .. child.Name
                    out[key] = (out[key] or 0) + 1
                end
            end
        end
    end
    return out
end

local function materialString(tbl)
    local keys = {}
    for k in pairs(tbl) do table.insert(keys, k) end
    table.sort(keys)
    local parts = {}
    for _, k in ipairs(keys) do table.insert(parts, tostring(k) .. "=" .. tostring(tbl[k])) end
    return table.concat(parts, ", ")
end

local materialSnapshot = nil
local function materialStart() materialSnapshot = nil; addLog("MATERIAL", "Material scanner started.") end
local function materialTick()
    local snap = collectMaterials()
    local str = materialString(snap)
    if not materialSnapshot then
        addLog("MATERIAL", "Initial materials: " .. (str ~= "" and str or "none"))
        materialSnapshot = snap
    elseif materialString(materialSnapshot) ~= str then
        addLog("MATERIAL", "Material changes: " .. (str ~= "" and str or "none"))
        materialSnapshot = snap
    end
    local count = 0
    for _ in pairs(snap) do count = count + 1 end
    setFeatureStatus("materials", tostring(count) .. " readable value(s)")
end

