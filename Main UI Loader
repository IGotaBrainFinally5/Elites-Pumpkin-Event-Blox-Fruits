-- Diagnostics
-- =========================================================

local DIAG_PATHS = {
    { "Remotes", "OnTalkToNPC" },
    { "Modules", "Net", "RF/GachaNetworkRF" },
    { "Modules", "Net", "RF/SceneNetwork" },
    { "Remotes", "CommF_" },
    { "Modules", "Net", "RE/RegisterHit" },
    { "Modules", "Net", "RE/RegisterAttack" },
}

local diagLast = 0

local function runDiagnostics(verbose)
    local present = 0
    for _, path in ipairs(DIAG_PATHS) do
        local obj = findRemotePath(ReplicatedStorage, path)
        local name = table.concat(path, ".")
        if obj then
            present = present + 1
            if verbose then
                addLog("DIAG", "FOUND " .. name .. " (" .. obj.ClassName .. ")")
            end
        elseif verbose then
            addLog("DIAG", "MISSING " .. name)
        end
    end
    setFeatureStatus("diag", tostring(present) .. "/" .. tostring(#DIAG_PATHS) .. " remotes present")
end

local function diagStart()
    diagLast = 0
    addLog("DIAG", "Remote diagnostics started.")
    runDiagnostics(true)
end

local function diagTick()
    if os.clock() - diagLast < 15 then
        return
    end
    diagLast = os.clock()
    runDiagnostics(false)
end

