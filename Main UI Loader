    for _, k in ipairs(MATERIAL_KEYWORDS) do if s:find(k,1,true) then return true end end
    return false
end
local function collectMaterials()
    local out = {}
    local function add(n, v) if hasMatKeyword(n) and type(v) == "number" then out[n] = v end end
    for k, v in pairs(player:GetAttributes()) do add("attr." .. tostring(k), v) end
    local ls = player:FindFirstChild("leaderstats")
    if ls then for _, c in ipairs(ls:GetChildren()) do if c:IsA("ValueBase") then add("leaderstats." .. c.Name, c.Value) end end end
    for _, cont in ipairs({ player:FindFirstChild("Backpack"), player.Character }) do
        if cont then
            for _, ch in ipairs(cont:GetChildren()) do
                if ch:IsA("Tool") and hasMatKeyword(ch.Name) then
                    local key = "tool." .. ch.Name
                    out[key] = (out[key] or 0) + 1
                end
            end
        end
    end
    return out
end
