local function fmt(v)
    if type(v) == "table" then
        local ok, res = pcall(function()
            return HttpService:JSONEncode(v)
        end)
        return ok and res or tostring(v)
    end
    return tostring(v)
end

local logEnabled = true
local logLines = {}
local logLabel
local logScroll
local summaryStatus
local updateSummary

local function addLog(tag, msg)
    if not logEnabled and tag ~= "SYS" then
        return
    end
    local line = string.format("%s [%s] %s", os.date("%H:%M:%S"), tostring(tag), tostring(msg))
    table.insert(logLines, line)
    while #logLines > CONFIG.MAX_LOG_LINES do
        table.remove(logLines, 1)
    end
    if logLabel then
        logLabel.Text = table.concat(logLines, "\n")
        task.defer(function()
            if logScroll and logLabel then
                logScroll.CanvasSize = UDim2.new(0, 0, 0, math.max(0, logLabel.AbsoluteSize.Y + 16))
            end
        end)
    end
    if updateSummary then
        updateSummary()
    end
end

