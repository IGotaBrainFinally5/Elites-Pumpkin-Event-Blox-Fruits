-- AUTO GACHA ROLL — THE MAIN FEATURE
-- =========================================================
local function fireGachaPurchase()
    local net = ReplicatedStorage:FindFirstChild("Modules")
    net = net and net:FindFirstChild("Net")
    local rf = net and net:FindFirstChild("RF/GachaNetworkRF")
    if not rf then
        return false, "no_remote"
    end
    local payload = { Context = "Purchase", BoxName = CONFIG.GACHA_BOX }
    local ok, res = pcall(function()
        if rf:IsA("RemoteFunction") then
            return rf:InvokeServer(payload)
        elseif rf:IsA("RemoteEvent") then
            rf:FireServer(payload)
            return "fired"
        else
            error("remote is " .. rf.ClassName)
        end
    end)
    if not ok then
        return false, tostring(res)
    end
    return true, res
end

local function registerRoll(source)
    autoGacha.rollsUsed = autoGacha.rollsUsed + 1
    manualGachaState.rollsUsed = manualGachaState.rollsUsed + 1
    addLog("AUTOGACHA", string.format("Roll counted (%d/2) via %s", autoGacha.rollsUsed, source))
end

local function autoGachaLoop()
    if os.clock() < autoGacha.waitUntil then
        local remain = autoGacha.waitUntil - os.clock()
        setFeatureStatus("auto_gacha", string.format("waiting %02d:%02d", math.floor(remain/60), math.floor(remain%60)))
        return
    end
    -- Fire Purchase
    local ccBefore = readCandyCorn()
    setFeatureStatus("auto_gacha", "firing Purchase...")
    local ok, res = fireGachaPurchase()
    if not ok then
        addLog("AUTOGACHA", "Purchase failed: " .. tostring(res))
        setFeatureStatus("auto_gacha", "error: " .. tostring(res))
        autoGacha.waitUntil = os.clock() + CONFIG.POST_FAIL_WAIT
        return
    end
    addLog("AUTOGACHA", "Purchase -> " .. fmt(res))
    -- Wait for server to process
    task.wait(CONFIG.FIRE_PROCESS_WAIT)
    -- Detect success via candy corn drop
    local ccAfter = readCandyCorn()
    local success, spent = false, 0
    if ccBefore and ccAfter then
        local delta = ccBefore - ccAfter
        if delta >= CONFIG.ROLL_CC_MIN and delta <= CONFIG.ROLL_CC_MAX then
            success, spent = true, delta
        elseif delta > 50 then
            success, spent = true, delta
        end
    end
    -- Check for wait message regardless
    local waitSec, waitMsg = watchForWaitMessage()
    if success then
        addLog("AUTOGACHA", string.format("Roll succeeded (spent %d CC)", spent))
        registerRoll("auto")
        if waitSec then
            autoGacha.waitUntil = os.clock() + waitSec
            autoGacha.lastCooldownFromMsg = waitSec
            addLog("AUTOGACHA", string.format("Server cooldown: %02d:%02d (\"%s\")", math.floor(waitSec/60), waitSec%60, tostring(waitMsg)))
        elseif autoGacha.rollsUsed >= 2 then
            autoGacha.waitUntil = os.clock() + CONFIG.FALLBACK_HOUR
            addLog("AUTOGACHA", "2 rolls used — waiting 1h (fallback)")
        else
            autoGacha.waitUntil = os.clock() + CONFIG.POST_SUCCESS_WAIT
        end
    else
        -- Failed. Maybe on cooldown.
        if waitSec then
            autoGacha.waitUntil = os.clock() + waitSec
            autoGacha.lastCooldownFromMsg = waitSec
            addLog("AUTOGACHA", string.format("On cooldown: %02d:%02d (from \"%s\")", math.floor(waitSec/60), waitSec%60, tostring(waitMsg)))
            setFeatureStatus("auto_gacha", "cooldown detected")
        else
            addLog("AUTOGACHA", "Purchase didn't succeed — retrying in " .. CONFIG.POST_FAIL_WAIT .. "s")
            setFeatureStatus("auto_gacha", "no success, retry")
            autoGacha.waitUntil = os.clock() + CONFIG.POST_FAIL_WAIT
        end
    end
end

local function startAutoGacha()
    if autoGacha.enabled then return end
    autoGacha.enabled = true
    autoGacha.rollsUsed = 0
    autoGacha.waitUntil = 0
    autoGacha.lastCCObserved = readCandyCorn()
    addLog("AUTOGACHA", "Auto Spooky Gacha Roll STARTED.")
    autoGacha.thread = task.spawn(function()
        while autoGacha.enabled do
            pcall(autoGachaLoop)
            -- While waiting, poll for wait message every 0.5s
            if os.clock() < autoGacha.waitUntil then
                local remain = autoGacha.waitUntil - os.clock()
                setFeatureStatus("auto_gacha", string.format("waiting %02d:%02d", math.floor(remain/60), math.floor(remain%60)))
                local checkAt = os.clock() + CONFIG.WAIT_MSG_POLL
                while autoGacha.enabled and os.clock() < autoGacha.waitUntil and os.clock() < checkAt do
                    local waitSec = watchForWaitMessage()
                    if waitSec and waitSec > 1 and math.abs(waitSec - (autoGacha.waitUntil - os.clock())) > 3 then
                        -- Server's cooldown differs from ours — trust server
                        autoGacha.waitUntil = os.clock() + waitSec
                    end
                    task.wait(0.2)
                end
            end
            task.wait(0.5)
        end
    end)
end

local function stopAutoGacha()
    autoGacha.enabled = false
    if autoGacha.thread then
        pcall(function() task.cancel(autoGacha.thread) end)
        autoGacha.thread = nil
    end
    setFeatureStatus("auto_gacha", "stopped")
    addLog("AUTOGACHA", "Auto Spooky Gacha Roll STOPPED.")
end

-- Manual roll detection (in case user rolls in-game)
local function detectManualRoll()
    local ccNow = readCandyCorn()
    if not ccNow then return end
    if manualGachaState.lastCCObserved ~= nil then
        local drop = manualGachaState.lastCCObserved - ccNow
        if drop >= CONFIG.ROLL_CC_MIN and drop <= CONFIG.ROLL_CC_MAX then
            if not autoGacha.enabled then
                registerRoll("manual")
            end
        end
    end
    manualGachaState.lastCCObserved = ccNow
end

