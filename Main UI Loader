        if obj then present = present + 1; if verbose then addLog("DIAG", "FOUND " .. name) end
        elseif verbose then addLog("DIAG", "MISSING " .. name) end
    end
    setFeatureStatus("diag", tostring(present) .. "/" .. tostring(#DIAG_PATHS))
end
local function diagStart() diagLast = 0; addLog("DIAG", "Started."); runDiag(true) end
local function diagTick() if os.clock() - diagLast < 15 then return end; diagLast = os.clock(); runDiag(false) end

-- NPC DETECT
local npcKnown = {}
local function npcStart() addLog("NPC", "Started. Diagnostic only."); npcKnown = {} end
local function npcStop() addLog("NPC", "Stopped."); npcKnown = {} end
local function npcTick()
    if os.clock() - npcLastScan < CONFIG.NPC_SCAN_INTERVAL then return end
    npcLastScan = os.clock()
    local char = player.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not hrp then setFeatureStatus("npc", "no character"); return end
    local found = {}
    local folder = Workspace:FindFirstChild("NPCs")
    if folder then
        local ok, desc = pcall(function() return folder:GetDescendants() end)
        if ok then
            for _, d in ipairs(desc) do
                if d:IsA("Model") and d:FindFirstChildOfClass("Humanoid") then
                    local r = d:FindFirstChild("HumanoidRootPart") or d.PrimaryPart
                    if r and r:IsA("BasePart") then
                        local dist = (r.Position - hrp.Position).Magnitude
                        if dist <= CONFIG.NPC_SCAN_RADIUS then found[d] = true end
                    end
                end
            end
        end
    end
    for obj in pairs(found) do
        if not npcKnown[obj] then npcKnown[obj] = true end
    end
    for obj in pairs(npcKnown) do if not found[obj] then npcKnown[obj] = nil end end
    local n = 0
    for _ in pairs(found) do n = n + 1 end
    setFeatureStatus("npc", tostring(n) .. " nearby")
end

