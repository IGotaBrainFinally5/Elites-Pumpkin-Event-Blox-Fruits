-- AUTO TRICK OR TREAT
-- =========================================================
local trickOrTreat = {
    running = false,
    thread = nil,
    delay = 1.5,
}

local function findTrickOrTreatDoors()
    local doors = {}
    local candidateRoots = {}
    for _, name in ipairs({ "Halloween", "NPCs", "PumpkinHunt" }) do
        local r = Workspace:FindFirstChild(name)
        if r then table.insert(candidateRoots, r) end
    end
    for _, child in ipairs(Workspace:GetChildren()) do
        if child:IsA("Model") and (child.Name:lower():find("door", 1, true) or child.Name:lower():find("trick", 1, true)) then
            table.insert(doors, child)
        end
    end
    for _, root in ipairs(candidateRoots) do
        local ok, descendants = pcall(function() return root:GetDescendants() end)
        if ok then
            for _, d in ipairs(descendants) do
                if d:IsA("Model") and (d.Name:lower():find("door", 1, true) or d.Name:lower():find("trick", 1, true) or d.Name:lower():find("treat", 1, true)) then
                    table.insert(doors, d)
                end
            end
        end
    end
    return doors
end

local function stopTrickOrTreat()
    trickOrTreat.running = false
    if trickOrTreat.thread then
        pcall(function() task.cancel(trickOrTreat.thread) end)
        trickOrTreat.thread = nil
    end
    addLog("TREAT", "Auto Trick or Treat stopped.")
end

local function trickOrTreatStart()
    if trickOrTreat.running then return end
    trickOrTreat.running = true
    addLog("TREAT", "Auto Trick or Treat started. Best-effort.")
    trickOrTreat.thread = task.spawn(function()
        while trickOrTreat.running do
            local char = player.Character
            local hrp = char and char:FindFirstChild("HumanoidRootPart")
            if not hrp then
                setFeatureStatus("treat", "no character")
                task.wait(1)
            else
                local doors = findTrickOrTreatDoors()
                if #doors == 0 then
                    setFeatureStatus("treat", "no doors found")
                else
                    local best, bestDist = nil, math.huge
                    for _, door in ipairs(doors) do
                        local root = door:FindFirstChild("RootPart") or door:FindFirstChild("HumanoidRootPart") or door.PrimaryPart
                        if root and root:IsA("BasePart") then
                            local dist = (root.Position - hrp.Position).Magnitude
                            if dist < bestDist then best, bestDist = door, dist end
                        end
                    end
                    if best and bestDist <= 10 then
                        local prompt = best:FindFirstChildWhichIsA("ProximityPrompt", true)
                        if prompt then
                            pcall(function() prompt:InputHoldBegin() end)
                            task.wait(0.1)
                            pcall(function() prompt:InputHoldEnd() end)
                            addLog("TREAT", "ProximityPrompt on " .. best.Name)
                        else
                            local remote = findRemotePath(ReplicatedStorage, { "Remotes", "OnTalkToNPC" })
                            if remote then
                                pcall(function() remote:FireServer(best) end)
                                addLog("TREAT", "OnTalkToNPC on " .. best.Name)
                            else
                                addLog("TREAT", "No interaction method for " .. best.Name)
                            end
                        end
                        task.wait(trickOrTreat.delay)
                    elseif best then
                        local hum = char and char:FindFirstChildOfClass("Humanoid")
                        if hum then
                            pcall(function()
                                local root = best:FindFirstChild("RootPart") or best:FindFirstChild("HumanoidRootPart") or best.PrimaryPart
                                if root then hum:MoveTo(root.Position) end
                            end)
                        end
                        setFeatureStatus("treat", string.format("moving to %s (%.0f studs)", best.Name, bestDist))
                    end
                end
            end
            task.wait(0.5)
        end
    end)
end

-- =========================================================
-- EVENT KEYWORD OBSERVER (event-driven, no full workspace scan)
-- =========================================================
local eventObserver = {
    running = false,
    thread = nil,
    connections = {},
    knownObjects = {},
}

local EVENT_KEYWORDS = { "trick", "treat", "dapper", "cursed", "seed", "spooky", "jack", "pumpkin", "halloween" }

local function isEventObject(inst)
    local n = inst.Name:lower()
    for _, k in ipairs(EVENT_KEYWORDS) do
        if n:find(k, 1, true) then return true end
    end
    return false
end

local function handleAdded(inst)
    if not eventObserver.running then return end
    if isEventObject(inst) and not eventObserver.knownObjects[inst] then
        eventObserver.knownObjects[inst] = true
        addLog("EVENT", "Added: " .. inst.ClassName .. ":" .. inst.Name)
    end
end

local function handleRemoved(inst)
    if eventObserver.knownObjects[inst] then
        eventObserver.knownObjects[inst] = nil
        addLog("EVENT", "Removed: " .. inst.ClassName .. ":" .. inst.Name)
    end
end

local function stopEventObserver()
    eventObserver.running = false
    for _, c in ipairs(eventObserver.connections) do
        pcall(function() c:Disconnect() end)
    end
    eventObserver.connections = {}
    eventObserver.knownObjects = {}
    if eventObserver.thread then
        pcall(function() task.cancel(eventObserver.thread) end)
        eventObserver.thread = nil
    end
    addLog("EVENT", "Event Keyword Observer stopped.")
end

local function eventObserverStart()
    if eventObserver.running then return end
    eventObserver.running = true
    eventObserver.knownObjects = {}
    eventObserver.connections = {}
    addLog("EVENT", "Event Keyword Observer started (event-driven).")

    local containers = {}
    for _, name in ipairs({ "PumpkinHunt", "NPCs", "Halloween" }) do
        local c = Workspace:FindFirstChild(name)
        if c then table.insert(containers, c) end
    end
    if #containers == 0 then
        addLog("EVENT", "No known event containers found.")
        setFeatureStatus("events", "no containers")
    else
        for _, c in ipairs(containers) do
            table.insert(eventObserver.connections, c.DescendantAdded:Connect(handleAdded))
            table.insert(eventObserver.connections, c.DescendantRemoved:Connect(handleRemoved))
        end
        for _, c in ipairs(containers) do
            local ok, descendants = pcall(function() return c:GetDescendants() end)
            if ok then
                for _, d in ipairs(descendants) do
                    if isEventObject(d) then eventObserver.knownObjects[d] = true end
                end
            end
        end
        addLog("EVENT", "Connected to " .. #containers .. " container(s).")
    end

    eventObserver.thread = task.spawn(function()
        while eventObserver.running do
            task.wait(CONFIG.EVENT_SCAN_INTERVAL)
            local count = 0
            for _ in pairs(eventObserver.knownObjects) do count = count + 1 end
            setFeatureStatus("events", tostring(count) .. " tracked")
        end
    end)
end

-- =========================================================
-- MATERIAL SCANNER
-- =========================================================
local MATERIAL_KEYWORDS = { "candy", "corn", "pumpkin", "bit", "seed", "treat", "halloween", "spooky", "soul", "bone" }

local function hasMaterialKeyword(name)
    local s = tostring(name):lower()
    for _, k in ipairs(MATERIAL_KEYWORDS) do
        if s:find(k, 1, true) then return true end
    end
    return false
end

local function collectMaterials()
    local out = {}
    local function add(name, value)
        if hasMaterialKeyword(name) and type(value) == "number" then out[name] = value end
    end
    for k, v in pairs(player:GetAttributes()) do add("attr." .. tostring(k), v) end
    local leaderstats = player:FindFirstChild("leaderstats")
    if leaderstats then
        for _, c in ipairs(leaderstats:GetChildren()) do
            if c:IsA("ValueBase") then add("leaderstats." .. c.Name, c.Value) end
        end
    end
    for _, cont in ipairs({ player:FindFirstChild("Backpack"), player.Character }) do
        if cont then
            for _, child in ipairs(cont:GetChildren()) do
                if child:IsA("Tool") and hasMaterialKeyword(child.Name) then
                    local key = "tool." .. child.Name
                    out[key] = (out[key] or 0) + 1
                end
            end
        end
    end
    return out
end

local function materialString(tbl)
    local keys = {}
    for k in pairs(tbl) do table.insert(keys, k) end
    table.sort(keys)
    local parts = {}
    for _, k in ipairs(keys) do table.insert(parts, tostring(k) .. "=" .. tostring(tbl[k])) end
    return table.concat(parts, ", ")
end

local materialSnapshot = nil
local function materialStart() materialSnapshot = nil; addLog("MATERIAL", "Material scanner started.") end
local function materialTick()
    local snap = collectMaterials()
    local str = materialString(snap)
    if not materialSnapshot then
        addLog("MATERIAL", "Initial materials: " .. (str ~= "" and str or "none"))
        materialSnapshot = snap
    elseif materialString(materialSnapshot) ~= str then
        addLog("MATERIAL", "Material changes: " .. (str ~= "" and str or "none"))
        materialSnapshot = snap
    end
    local count = 0
    for _ in pairs(snap) do count = count + 1 end
    setFeatureStatus("materials", tostring(count) .. " readable value(s)")
end

