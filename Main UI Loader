local function fmt(v)
    if type(v) == "table" then
        local ok, res = pcall(function()
            return HttpService:JSONEncode(v)
        end)
        return ok and res or tostring(v)
    end
    return tostring(v)
end

local logEnabled = true
local logLines = {}
local logLabel
local logScroll
local summaryStatus
local updateSummary

local function addLog(tag, msg)
    if not logEnabled and tag ~= "SYS" and tag ~= "ERROR" then
        return
    end
    local line = string.format("%s [%s] %s", os.date("%H:%M:%S"), tostring(tag), tostring(msg))
    table.insert(logLines, line)
    while #logLines > CONFIG.MAX_LOG_LINES do
        table.remove(logLines, 1)
    end
    if logLabel then
        logLabel.Text = table.concat(logLines, "\n")
        if logScroll then
            local bounds = 0
            local ok, b = pcall(function()
                return logLabel.TextBounds.Y
            end)
            if ok and type(b) == "number" and b > 0 then
                bounds = b
            else
                bounds = #logLines * 16
            end
            logScroll.CanvasSize = UDim2.new(0, 0, 0, math.max(bounds + 16, 32))
        end
    end
    if updateSummary then
        updateSummary()
    end
end

local function applyCorner(frame, radius)
    local ok = pcall(function()
        local c = Instance.new("UICorner")
        c.CornerRadius = UDim2.fromOffset(radius, radius)
        c.Parent = frame
    end)
    return ok
end

local function applyBorder(frame, color)
    frame.BorderSizePixel = 1
    frame.BorderColor3 = color or THEME.Border
end

local function newFrame(parent, color, size, pos)
    local f = Instance.new("Frame")
    f.BackgroundColor3 = color or THEME.Panel
    f.BorderSizePixel = 0
    f.Size = size
    f.Position = pos
    f.Parent = parent
    return f
end

local function makeLabel(parent, text, size, pos, textSize, color, bold)
    local l = Instance.new("TextLabel")
    l.BackgroundTransparency = 1
    l.BorderSizePixel = 0
    l.BackgroundColor3 = Color3.new(0, 0, 0)
    l.Text = text
    l.TextColor3 = color or THEME.Text
    l.TextSize = textSize or 14
    l.Font = bold and FONT_BOLD or FONT_REG
    l.TextXAlignment = Enum.TextXAlignment.Left
    l.TextYAlignment = Enum.TextYAlignment.Top
    l.Size = size
    l.Position = pos
    l.Parent = parent
    return l
end

local function makeButton(parent, text, size, pos)
