-- =========================================================
-- STORE HOOK (observe StoreFruit calls to confirm storage)
-- =========================================================
local function tryHookStore()
    local remotes = ReplicatedStorage:FindFirstChild("Remotes")
    local commF = remotes and remotes:FindFirstChild("CommF_")
    if not commF then return false end

    local okHook = false
    -- Preferred: hookmetamethod
    pcall(function()
        if type(hookmetamethod) ~= "function" or type(getnamecallmethod) ~= "function" then
            error("no hookmetamethod")
        end
        local old
        old = hookmetamethod(game, "__namecall", function(self, ...)
            local method = getnamecallmethod()
            if method == "InvokeServer" and self == commF then
                local a1 = ...
                if a1 == "StoreFruit" then
                    local a2 = select(2, ...)
                    lastStoreAttempt = { fruit = tostring(a2), time = os.clock() }
                end
            end
            return old(self, ...)
        end)
        okHook = true
    end)

    if okHook then
        storeHookActive = true
        warn("[EHF] Store hook active (hookmetamethod).")
        return true
    end

    -- Fallback: raw metatable
    pcall(function()
        if type(getrawmetatable) ~= "function" or type(setreadonly) ~= "function" then
            error("no raw mt")
        end
        if type(newcclosure) ~= "function" or type(getnamecallmethod) ~= "function" then
            error("no namecall introspection")
        end
        local mt = getrawmetatable(game)
        local old = mt.__namecall
        setreadonly(mt, false)
        mt.__namecall = newcclosure(function(self, ...)
            local method = getnamecallmethod()
            if method == "InvokeServer" and self == commF then
                local a1 = ...
                if a1 == "StoreFruit" then
                    local a2 = select(2, ...)
                    lastStoreAttempt = { fruit = tostring(a2), time = os.clock() }
                end
            end
            return old(self, ...)
        end)
        setreadonly(mt, true)
        okHook = true
    end)

    if okHook then
        storeHookActive = true
        warn("[EHF] Store hook active (raw metatable).")
        return true
    end

    warn("[EHF] Store hook unavailable on this executor; storage detection will be inference-only.")
    return false
end

tryHookStore()

