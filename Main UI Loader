local EVENT_KEYWORDS = { "trick", "treat", "dapper", "cursed", "seed", "spooky", "jack", "pumpkin", "halloween" }
local eventLast = {}

local function scanEventObjects()
    local roots = {}
    local function addRoot(name)
        local r = Workspace:FindFirstChild(name)
        if r then
            table.insert(roots, r)
        end
    end
    addRoot("PumpkinHunt")
    addRoot("NPCs")
    addRoot("Halloween")
    if #roots == 0 then
        table.insert(roots, Workspace)
    end
    local found = {}
    for _, root in ipairs(roots) do
        local ok, descendants = pcall(function()
            return root:GetDescendants()
        end)
        if ok then
            for _, d in ipairs(descendants) do
                local n = d.Name:lower()
                for _, k in ipairs(EVENT_KEYWORDS) do
                    if n:find(k, 1, true) then
                        found[d] = d.ClassName .. ":" .. d.Name
                        break
                    end
                end
            end
        end
    end
    return found
end

local function eventStart()
    eventLast = {}
    addLog("EVENT", "Event keyword observer started.")
end

local function eventTick()
    local found = scanEventObjects()
    for obj, desc in pairs(found) do
        if not eventLast[obj] then
            addLog("EVENT", "Detected " .. desc)
        end
    end
    for obj, desc in pairs(eventLast) do
        if not found[obj] then
            addLog("EVENT", "No longer visible " .. desc)
        end
    end
    eventLast = found
    local count = 0
    for _ in pairs(found) do
        count = count + 1
    end
    setFeatureStatus("events", tostring(count) .. " keyword object(s)")
end

-- =========================================================
-- Gacha monitor
-- =========================================================

local gachaLastPresent = nil

local function invokeGachaContext(context)
    local rf = getGachaRF()
    if not rf then
        addLog("GACHA", "RF/GachaNetworkRF missing. Cannot call " .. tostring(context))
        return false
    end
    local payload = { Context = context, BoxName = CONFIG.GACHA_BOX }
    local ok, res = pcall(function()
        if rf:IsA("RemoteFunction") then
            return rf:InvokeServer(payload)
        elseif rf:IsA("RemoteEvent") then
            rf:FireServer(payload)
            return "fired"
        else
            error("Unsupported remote class: " .. rf.ClassName)
        end
    end)
    if ok then
        addLog("GACHA", tostring(context) .. " -> " .. fmt(res))
        return true, res
    end
    addLog("ERROR", "Gacha " .. tostring(context) .. " failed: " .. tostring(res))
    return false
end

local function probeGacha()
    addLog("GACHA", "Probing Halloween26Gacha (GetPityData, Check). No purchase.")
    invokeGachaContext("GetPityData")
    task.wait(0.3)
    invokeGachaContext("Check")
end

local function gachaStart()
    gachaLastPresent = nil
    addLog("GACHA", "Halloween Gacha monitor started.")
end

local function gachaTick()
    local present = getGachaRF() ~= nil
    if present ~= gachaLastPresent then
        gachaLastPresent = present
        addLog("GACHA", present and "RF/GachaNetworkRF present." or "RF/GachaNetworkRF missing.")
    end
    setFeatureStatus("gacha", present and "remote present" or "remote missing")
end

local purchaseConfirmUntil = 0

local function requestGachaPurchase()
    if os.clock() < purchaseConfirmUntil then
        purchaseConfirmUntil = 0
        addLog("GACHA", "Manual Purchase requested. Server will validate.")
        invokeGachaContext("Purchase")
    else
        purchaseConfirmUntil = os.clock() + 5
        addLog("WARN", "Tap Buy Gacha again within 5 seconds to confirm. May spend 500 Candy Corn.")
    end
end

-- =========================================================
-- Fruit observer
-- =========================================================

local fruitLastString = nil

local function collectFruits()
    local out = {}
    local containers = { player:FindFirstChild("Backpack"), player.Character }
    for _, cont in ipairs(containers) do
        if cont then
            for _, child in ipairs(cont:GetChildren()) do
                if child:IsA("Tool") then
                    table.insert(out, child.Name)
                end
            end
        end
    end
    table.sort(out)
    return out
end

local function fruitStart()
    fruitLastString = nil
    addLog("FRUIT", "Fruit inventory observer started.")
end

local function fruitTick()
    local list = collectFruits()
    local str = table.concat(list, ", ")
    if fruitLastString ~= str then
        addLog("FRUIT", "Tools: " .. (str ~= "" and str or "none"))
        fruitLastString = str
    end
    setFeatureStatus("fruits", tostring(#list) .. " tool(s)")
end

-- =========================================================
-- Respawn countdown
-- =========================================================

local function respawnStart()
    addLog("RESPAWN", "Respawn countdown started (observed 690s estimate).")
end

local function respawnTick()
    if respawnEndsAt then
        local remain = respawnEndsAt - os.clock()
        if remain > 0 then
            setFeatureStatus("respawn", string.format("Est. %02d:%02d", math.floor(remain / 60), math.floor(remain % 60)))
        else
            if not respawnNotified then
                addLog("RESPAWN", "Local 690s estimate reached.")
                respawnNotified = true
            end
            setFeatureStatus("respawn", "Estimate reached")
            respawnEndsAt = nil
        end
    else
        setFeatureStatus("respawn", "waiting for pumpkin removal")
    end
end

