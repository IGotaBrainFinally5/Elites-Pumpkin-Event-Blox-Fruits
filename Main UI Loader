local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local QuestConfig = require(ReplicatedStorage:WaitForChild("QuestConfig"))

local QuestService = {}

local function ensureRemote(className, name)
    local r = ReplicatedStorage:FindFirstChild(name)
    if not r then
        r = Instance.new(className)
        r.Name = name
        r.Parent = ReplicatedStorage
    end
    return r
end

local RequestQuest  = ensureRemote("RemoteFunction", "RequestQuest")
local QuestUpdated  = ensureRemote("RemoteEvent", "QuestUpdated")
local QuestProgress = ensureRemote("RemoteEvent", "QuestProgress")

local playerData = {}

local function getData(player)
    if not playerData[player] then
        playerData[player] = { ActiveQuest = nil, Progress = 0 }
    end
    return playerData[player]
end

local function pushState(player)
    local d = getData(player)
    QuestUpdated:FireClient(player, d.ActiveQuest, d.Progress)
end

-- Requirement #2: only assign if no active quest, OR a strictly
-- higher-level quest is available.
RequestQuest.OnServerInvoke = function(player)
    local d = getData(player)
    local level = player:GetAttribute("Level") or 1
    local best = QuestConfig.GetBestQuestForLevel(level)

    if not best then
        return { ok = false, reason = "No quest available at this level" }
    end

    if d.ActiveQuest and best.Level <= d.ActiveQuest.Level then
        return { ok = false, reason = "Active quest exists; no higher-level quest available" }
    end

    d.ActiveQuest = best
    d.Progress = 0
    pushState(player)
    return { ok = true, quest = best }
end

-- Requirement #3: strict enemy name match, so "Fishman Lord" never
-- counts as "Fishman Commando".
function QuestService.RegisterKill(player, enemyName)
    local d = playerData[player]
    if not d or not d.ActiveQuest then return end
    if d.ActiveQuest.EnemyName ~= enemyName then return end

    d.Progress = math.min(d.Progress + 1, d.ActiveQuest.Count)
    QuestProgress:FireClient(player, d.Progress, d.ActiveQuest.Count)

    if d.Progress >= d.ActiveQuest.Count then
        local reward = d.ActiveQuest.Reward or 0
        local xp = (player:GetAttribute("XP") or 0) + reward
        player:SetAttribute("XP", xp)

        local newLevel = math.floor(xp / 100) + 1
        if newLevel > (player:GetAttribute("Level") or 1) then
            player:SetAttribute("Level", newLevel)
        end

        d.ActiveQuest = nil
        d.Progress = 0
        pushState(player)
    end
end

Players.PlayerAdded:Connect(function(player)
    if not player:GetAttribute("Level") then player:SetAttribute("Level", 1) end
    if not player:GetAttribute("XP")    then player:SetAttribute("XP", 0)    end
    getData(player)
    -- Requirement #5: re-push state on level change so the client
    -- re-evaluates whether a new quest is available.
    player:GetAttributeChangedSignal("Level"):Connect(function()
        pushState(player)
    end)
end)

Players.PlayerRemoving:Connect(function(player)
    playerData[player] = nil
end)

return QuestService


