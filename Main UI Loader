local function purgeAll()
    local parents = {}
    local okPg, pg = pcall(function() return player:FindFirstChild("PlayerGui") end)
    if okPg and pg then table.insert(parents, pg) end
    local okCg, cg = pcall(function() return CoreGui end)
    if okCg and cg then table.insert(parents, cg) end
    local okHui, hui = pcall(function() return gethui and gethui() end)
    if okHui and hui then table.insert(parents, hui) end
    for _, p in ipairs(parents) do
        local old = p:FindFirstChild("ElitesHalloweenFarm")
        if old then
            old:Destroy()
            warn("[EHF] Purged stale ElitesHalloweenFarm from " .. tostring(p))
        end
    end
end
