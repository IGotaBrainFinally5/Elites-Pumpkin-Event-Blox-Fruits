-- RESPAWN COUNTDOWN
-- =========================================================
local respawnEndsAt = nil
local respawnNotified = true
local function respawnStart() addLog("RESPAWN", "Started.") end
local function respawnTick()
    if respawnEndsAt then
        local remain = respawnEndsAt - os.clock()
        if remain > 0 then
            setFeatureStatus("respawn", string.format("%02d:%02d", math.floor(remain/60), math.floor(remain%60)))
        else
            if not respawnNotified then
                addLog("RESPAWN", "Estimate reached.")
                respawnNotified = true
            end
            setFeatureStatus("respawn", "Estimate reached")
            respawnEndsAt = nil
        end
    else
        setFeatureStatus("respawn", "waiting")
    end
end

