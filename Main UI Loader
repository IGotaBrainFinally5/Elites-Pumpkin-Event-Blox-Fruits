-- AUTO TRICK OR TREAT
-- =========================================================
local trickOrTreat = { running = false, thread = nil, delay = 1.5 }

local function setToTStatus(text)
    setFeatureStatus("treat", text)
end

local function findTrickOrTreatDoors()
    local doors = {}
    local roots = {}
    for _, name in ipairs({ "Halloween", "NPCs", "PumpkinHunt" }) do
        local r = Workspace:FindFirstChild(name)
        if r then table.insert(roots, r) end
    end
    for _, child in ipairs(Workspace:GetChildren()) do
        if child:IsA("Model") and (child.Name:lower():find("door", 1, true) or child.Name:lower():find("trick", 1, true)) then
            table.insert(doors, child)
        end
    end
    for _, root in ipairs(roots) do
        local ok, desc = pcall(function() return root:GetDescendants() end)
        if ok then
            for _, d in ipairs(desc) do
                if d:IsA("Model") and (d.Name:lower():find("door", 1, true) or d.Name:lower():find("trick", 1, true) or d.Name:lower():find("treat", 1, true)) then
                    table.insert(doors, d)
                end
            end
        end
    end
    return doors
end

local function stopTrickOrTreat()
    trickOrTreat.running = false
    if trickOrTreat.thread then
        pcall(function() task.cancel(trickOrTreat.thread) end)
        trickOrTreat.thread = nil
    end
    setToTStatus("Stopped")
    addLog("TREAT", "Stopped.")
end

local function trickOrTreatStart()
    if trickOrTreat.running then return end
    trickOrTreat.running = true
    setToTStatus("Searching...")
    addLog("TREAT", "Started.")
    trickOrTreat.thread = task.spawn(function()
        while trickOrTreat.running do
            local ok, err = pcall(function()
                local char = player.Character
                local hrp = char and char:FindFirstChild("HumanoidRootPart")
                local hum = char and char:FindFirstChildOfClass("Humanoid")
                if not hrp or not hum then
                    setToTStatus("Error: no character")
                    task.wait(1)
                    return
                end
                if hum.PlatformStand then
                    setToTStatus("Waiting: movement disabled by other feature")
                    task.wait(1)
                    return
                end
                local doors = findTrickOrTreatDoors()
                if #doors == 0 then
                    setToTStatus("Searching (no doors found)")
                    task.wait(2)
                    return
                end
                local best, bestDist = nil, math.huge
                for _, door in ipairs(doors) do
                    local r = door:FindFirstChild("RootPart") or door:FindFirstChild("HumanoidRootPart") or door.PrimaryPart
                    if r and r:IsA("BasePart") then
                        local d = (r.Position - hrp.Position).Magnitude
                        if d < bestDist then best, bestDist = door, d end
                    end
                end
                if not best then
                    setToTStatus("Searching (no reachable doors)")
                    task.wait(2)
                    return
                end
                if bestDist <= 10 then
                    setToTStatus("Interaction attempted: " .. best.Name)
                    local prompt = best:FindFirstChildWhichIsA("ProximityPrompt", true)
                    if prompt then
                        pcall(function() prompt:InputHoldBegin() end)
                        task.wait(0.1)
                        pcall(function() prompt:InputHoldEnd() end)
                        addLog("TREAT", "Prompt on " .. best.Name)
                    else
                        local remote = findRemotePath(ReplicatedStorage, { "Remotes", "OnTalkToNPC" })
                        if remote then
                            pcall(function() remote:FireServer(best) end)
                            addLog("TREAT", "OnTalkToNPC on " .. best.Name)
                        else
                            addLog("TREAT", "No interaction method for " .. best.Name)
                            setToTStatus("Error: no interaction method")
                        end
                    end
                    lastTotInteractionAt = os.clock()
                    setToTStatus("Waiting (cooldown)")
                    task.wait(trickOrTreat.delay)
                else
                    setToTStatus(string.format("Target found: %s (%.0f studs)", best.Name, bestDist))
                    local r = best:FindFirstChild("RootPart") or best:FindFirstChild("HumanoidRootPart") or best.PrimaryPart
                    if r then pcall(function() hum:MoveTo(r.Position) end) end
                end
            end)
            if not ok then
                setToTStatus("Error: " .. tostring(err))
                addLog("ERROR", "ToT tick: " .. tostring(err))
            end
            task.wait(0.5)
        end
    end)
end

-- =========================================================
-- EVENT KEYWORD OBSERVER
-- =========================================================
local eventObserver = { running = false, thread = nil, connections = {}, knownObjects = {} }
local EVENT_KEYWORDS = { "trick", "treat", "dapper", "cursed", "seed", "spooky", "jack", "pumpkin", "halloween" }
local function isEventObject(inst)
    local n = inst.Name:lower()
    for _, k in ipairs(EVENT_KEYWORDS) do if n:find(k, 1, true) then return true end end
    return false
end
local function handleAdded(inst)
    if not eventObserver.running then return end
    if isEventObject(inst) and not eventObserver.knownObjects[inst] then
        eventObserver.knownObjects[inst] = true
    end
end
local function handleRemoved(inst)
    if eventObserver.knownObjects[inst] then eventObserver.knownObjects[inst] = nil end
end
local function stopEventObserver()
    eventObserver.running = false
    for _, c in ipairs(eventObserver.connections) do pcall(function() c:Disconnect() end) end
    eventObserver.connections = {}
    eventObserver.knownObjects = {}
    if eventObserver.thread then
        pcall(function() task.cancel(eventObserver.thread) end)
        eventObserver.thread = nil
    end
    addLog("EVENT", "Stopped.")
end
local function eventObserverStart()
    if eventObserver.running then return end
    eventObserver.running = true
    eventObserver.knownObjects = {}
    eventObserver.connections = {}
    addLog("EVENT", "Started (event-driven).")
    local containers = {}
    for _, name in ipairs({ "PumpkinHunt", "NPCs", "Halloween" }) do
        local c = Workspace:FindFirstChild(name)
        if c then table.insert(containers, c) end
    end
    if #containers == 0 then
        setFeatureStatus("events", "no containers")
        addLog("EVENT", "No known containers.")
    else
        for _, c in ipairs(containers) do
            table.insert(eventObserver.connections, c.DescendantAdded:Connect(handleAdded))
            table.insert(eventObserver.connections, c.DescendantRemoved:Connect(handleRemoved))
        end
        for _, c in ipairs(containers) do
            local ok, desc = pcall(function() return c:GetDescendants() end)
            if ok then
                for _, d in ipairs(desc) do if isEventObject(d) then eventObserver.knownObjects[d] = true end end
            end
        end
    end
    eventObserver.thread = task.spawn(function()
        while eventObserver.running do
            task.wait(CONFIG.EVENT_SCAN_INTERVAL)
            local n = 0
            for _ in pairs(eventObserver.knownObjects) do n = n + 1 end
            setFeatureStatus("events", tostring(n) .. " tracked")
        end
    end)
end

-- =========================================================
-- MATERIAL SCANNER
-- =========================================================
local MATERIAL_KEYWORDS = { "candy", "corn", "pumpkin", "bit", "seed", "treat", "halloween", "spooky", "soul", "bone" }
local function hasMaterialKeyword(name)
    local s = tostring(name):lower()
    for _, k in ipairs(MATERIAL_KEYWORDS) do if s:find(k, 1, true) then return true end end
    return false
end
local function collectMaterials()
    local out = {}
    local function add(name, value)
        if hasMaterialKeyword(name) and type(value) == "number" then out[name] = value end
    end
    for k, v in pairs(player:GetAttributes()) do add("attr." .. tostring(k), v) end
    local ls = player:FindFirstChild("leaderstats")
    if ls then
        for _, c in ipairs(ls:GetChildren()) do
            if c:IsA("ValueBase") then add("leaderstats." .. c.Name, c.Value) end
        end
    end
    for _, cont in ipairs({ player:FindFirstChild("Backpack"), player.Character }) do
        if cont then
            for _, child in ipairs(cont:GetChildren()) do
                if child:IsA("Tool") and hasMaterialKeyword(child.Name) then
                    local key = "tool." .. child.Name
                    out[key] = (out[key] or 0) + 1
                end
            end
        end
    end
    return out
end
local function materialString(tbl)
    local keys = {}
    for k in pairs(tbl) do table.insert(keys, k) end
    table.sort(keys)
    local parts = {}
    for _, k in ipairs(keys) do table.insert(parts, k .. "=" .. tostring(tbl[k])) end
    return table.concat(parts, ", ")
end
local materialSnapshot = nil
local function materialStart() materialSnapshot = nil; addLog("MATERIAL", "Started.") end
local function materialTick()
    local snap = collectMaterials()
    local str = materialString(snap)
    if not materialSnapshot then
        addLog("MATERIAL", "Initial: " .. (str ~= "" and str or "none"))
        materialSnapshot = snap
    elseif materialString(materialSnapshot) ~= str then
        addLog("MATERIAL", "Changes: " .. (str ~= "" and str or "none"))
        materialSnapshot = snap
    end
    local n = 0
    for _ in pairs(snap) do n = n + 1 end
    setFeatureStatus("materials", tostring(n) .. " value(s)")
end

