    if not fruitsScroll then return end
    if not fruitDirty then return end
    fruitDirty = false
    for _, c in ipairs(fruitsScroll:GetChildren()) do
        if c:IsA("Frame") or c:IsA("TextLabel") then c:Destroy() end
    end
    local names = {}
    for n in pairs(fruitHistory) do table.insert(names, n) end
    table.sort(names)
    local rowH = 28
    local y = 0
    for _, name in ipairs(names) do
        local h = fruitHistory[name]
        local row = Instance.new("Frame")
        row.BackgroundColor3 = THEME.Background
        row.BackgroundTransparency = 0.2
        row.BorderSizePixel = 0
        row.Size = UDim2.new(1, -8, 0, rowH)
        row.Position = UDim2.fromOffset(4, y)
        row.ZIndex = 4
        row.Parent = fruitsScroll
        applyCorner(row, 4)
        local dot = Instance.new("Frame")
        dot.BackgroundColor3 = statusColor(h.status)
        dot.BorderSizePixel = 0
        dot.Size = UDim2.fromOffset(12, 12)
        dot.Position = UDim2.new(0, 6, 0.5, 0)
        dot.AnchorPoint = Vector2.new(0, 0.5)
        dot.ZIndex = 5
        dot.Parent = row
        applyCorner(dot, 6)
        local nm = makeLabel(row, name, UDim2.new(1, -164, 1, 0), UDim2.fromOffset(24, 0), 11, THEME.Text, true)
        nm.TextYAlignment = Enum.TextYAlignment.Center
        nm.TextTruncate = Enum.TextTruncate.AtEnd
        nm.ZIndex = 5
        local cnt = makeLabel(row, "×" .. tostring(h.count), UDim2.new(0, 50, 1, 0), UDim2.new(1, -138, 0, 0), 11, THEME.Muted, true)
        cnt.TextXAlignment = Enum.TextXAlignment.Center
        cnt.TextYAlignment = Enum.TextYAlignment.Center
        cnt.ZIndex = 5
        local st = makeLabel(row, statusText(h.status), UDim2.new(0, 76, 1, 0), UDim2.new(1, -82, 0, 0), 10, statusColor(h.status), true)
        st.TextXAlignment = Enum.TextXAlignment.Center
        st.TextYAlignment = Enum.TextYAlignment.Center
        st.ZIndex = 5
        y = y + rowH + 2
    end
    if #names == 0 then
        local empty = makeLabel(fruitsScroll, "No fruits rolled yet.", UDim2.new(1, -16, 0, 20), UDim2.fromOffset(8, 6), 11, THEME.Muted, false)
        empty.TextXAlignment = Enum.TextXAlignment.Center
        empty.TextYAlignment = Enum.TextYAlignment.Center
        empty.ZIndex = 5
        y = 28
    end
    fruitsScroll.CanvasSize = UDim2.new(0, 0, 0, y + 8)
end

