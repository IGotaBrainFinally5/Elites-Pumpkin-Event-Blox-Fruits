    local n = tonumber(distBox.Text)
    if n and n >= 5 and n <= 100 then
        state.SafeDistance = n
    end
    distBox.Text = tostring(state.SafeDistance)
    distLabel.Text = "Safe Distance: " .. state.SafeDistance
end)

_G.RefreshGUI = function()
    if state.ActiveQuest then
        status.Text = string.format(
            "Quest: %s\nTarget: %s\nProgress: %d / %d",
            state.ActiveQuest.Id,
            state.ActiveQuest.EnemyName,
            state.Progress,
            state.ActiveQuest.Count
        )
    else
        status.Text = "No active quest"
    end
end

_G.RefreshGUI()
