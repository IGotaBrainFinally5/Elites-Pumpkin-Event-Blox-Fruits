task.spawn(function()
    while screenGui.Parent do
        for _, id in ipairs(featureOrder) do
            local f = features[id]
            if f and f.running and f.onTick then
                local ok, err = pcall(f.onTick)
                if not ok then
                    addLog("ERROR", f.name .. " tick failed: " .. tostring(err))
                    setFeatureStatus(id, "error")
                end
            end
        end
        task.wait(CONFIG.FEATURE_TICK)
    end
end)

