local function checkDefensiveEvade()
    if not features["evade"] or not features["evade"].running then return end
    if os.clock() - lastEvadeCheck < CONFIG.EVADE_CHECK_INTERVAL then return end
    lastEvadeCheck = os.clock()
    local char = player.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not hum or not hrp then return end
    local ratio = hum.Health / math.max(1, hum.MaxHealth)
    if not pumpkinFarm.evading then
        if ratio < CONFIG.EVADE_HP_THRESHOLD then
            pumpkinFarm.evading = true
            pumpkinFarm.currentPumpkin = nil
            pumpkinFarm.currentRoot = nil
            pumpkinFarm.flyTarget = hrp.Position + Vector3.new(0, CONFIG.EVADE_HEIGHT, 0)
            pumpkinFarm.state = "EVADING"
            setFeatureStatus("evade", string.format("EVADING (HP %.0f%%)", ratio * 100))
            addLog("EVADE", string.format("HP %.0f%% < %.0f%% — flying up to disengage.", ratio * 100, CONFIG.EVADE_HP_THRESHOLD * 100))
        end
    else
        if ratio >= CONFIG.EVADE_RECOVER_HP then
            pumpkinFarm.evading = false
            setFeatureStatus("evade", string.format("recovered (HP %.0f%%)", ratio * 100))
            addLog("EVADE", "HP recovered — resuming farm.")
        else
            setFeatureStatus("evade", string.format("EVADING (HP %.0f%%)", ratio * 100))
            if not pumpkinFarm.flyTarget then
                pumpkinFarm.flyTarget = hrp.Position + Vector3.new(0, 10, 0)
            end
        end
    end
end

local function pumpkinFarmTick()
    local char = player.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not hrp then setFeatureStatus("pumpkin", "no character"); return end

    -- Priority 1: defensive evade
    if pumpkinFarm.evading then return end
    -- Priority 2: fruit guard
    if fruitGuardPaused then return end

    local now = os.clock()
    for k, v in pairs(pumpkinFarm.blacklist) do
        if v < now or not k.Parent then pumpkinFarm.blacklist[k] = nil end
    end

    if pumpkinFarm.currentPumpkin then
        local p = pumpkinFarm.currentPumpkin
        local r = pumpkinFarm.currentRoot
        if not p.Parent or not r or not r.Parent then
            if pumpkinFarm.state == "ATTACKING" then
                stats.pumpkinsFarmed = stats.pumpkinsFarmed + 1
                pumpkinFarm.lastKillTime = os.clock()
                addLog("PUMPKIN", string.format("Target disappeared. Farmed: %d", stats.pumpkinsFarmed))
            end
            pumpkinFarm.currentPumpkin = nil
            pumpkinFarm.currentRoot = nil
            pumpkinFarm.flyTarget = nil
            pumpkinFarm.weaponEquippedFor = nil
            resetStuckTracking()
        end
    end

    if not pumpkinFarm.currentPumpkin then
        local p, r, dist = findClosestPumpkin()
        if p and r then
            setTarget(p, r, dist, "nearest")
            pumpkinFarm.lastRespawnAt = nil
        else
            pumpkinFarm.state = "WAITING"
            pumpkinFarm.flyTarget = nil
            if not pumpkinFarm.lastRespawnAt then pumpkinFarm.lastRespawnAt = os.clock() end
            setFeatureStatus("pumpkin", string.format("waiting (%.0fs)", os.clock() - pumpkinFarm.lastRespawnAt))
            return
        end
    end

    local root = pumpkinFarm.currentRoot
    local pumpkin = pumpkinFarm.currentPumpkin
    if not root or not pumpkin then return end
    local dist = (root.Position - hrp.Position).Magnitude

    if pumpkinFarm.state == "MOVING" and dist > CONFIG.SWITCH_MIN_DIST then
        if os.clock() - pumpkinFarm.lastSwitchCheck > CONFIG.SWITCH_CHECK_INTERVAL then
            pumpkinFarm.lastSwitchCheck = os.clock()
            local np, nr, ndist = findClosestPumpkin()
            if np and np ~= pumpkin and ndist and ndist < dist - CONFIG.SWITCH_MARGIN then
                setTarget(np, nr, ndist, "closer")
                return
            end
        end
    end

    if os.clock() - pumpkinFarm.lastDistLog > CONFIG.TARGET_DIST_LOG_INTERVAL then
        pumpkinFarm.lastDistLog = os.clock()
        addLog("PUMPKIN", string.format("Current %s: %.1f studs", tostring(pumpkin.Name), dist))
    end

    if pumpkinFarm.state == "MOVING" then
        if pumpkinFarm.lastDistance then
            if (pumpkinFarm.lastDistance - dist) < CONFIG.PROGRESS_THRESHOLD then
                pumpkinFarm.stuckTime = pumpkinFarm.stuckTime + CONFIG.PUMPKIN_TICK_INTERVAL
            else pumpkinFarm.stuckTime = 0 end
        end
        pumpkinFarm.lastDistance = dist
        if pumpkinFarm.lastY then
            local dy = hrp.Position.Y - pumpkinFarm.lastY
            if pumpkinFarm.lastDy and math.abs(dy) > 0.1 and math.abs(pumpkinFarm.lastDy) > 0.1 then
                if (dy > 0) ~= (pumpkinFarm.lastDy > 0) then pumpkinFarm.oscillationCount = pumpkinFarm.oscillationCount + 1 end
            end
            pumpkinFarm.lastDy = dy
        end
        pumpkinFarm.lastY = hrp.Position.Y
        if pumpkinFarm.stuckTime >= CONFIG.STUCK_TIMEOUT then blacklistTarget(string.format("no progress %.1fs", pumpkinFarm.stuckTime)); return end
        if pumpkinFarm.oscillationCount >= CONFIG.OSCILLATION_THRESHOLD then blacklistTarget(string.format("Y-osc x%d", pumpkinFarm.oscillationCount)); return end
    end

    if dist > CONFIG.TOUCH_DISTANCE then
        if not pumpkinFarm.flyTarget then pumpkinFarm.flyTarget = computeSafeFlyTarget(root.Position, pumpkin) end
        pumpkinFarm.state = "MOVING"
        setFeatureStatus("pumpkin", string.format("flying %.0f @ %d/s", dist, pumpkinFarm.speed))
    else
        pumpkinFarm.flyTarget = nil
        if pumpkinFarm.state ~= "ATTACKING" then
            pumpkinFarm.state = "ATTACKING"
            pumpkinFarm.attackStartedAt = os.clock()
        end
        if pumpkinFarm.weaponEquippedFor ~= pumpkin then
            local eq = equipWeaponOfCategory(pumpkinFarm.weaponCategory)
            pumpkinFarm.weaponEquippedFor = pumpkin
            if eq then addLog("WEAPON", "Equipped: " .. eq.Name) end
        end
        local cur = char and char:FindFirstChildOfClass("Tool")
        setFeatureStatus("pumpkin", "attacking " .. pumpkin.Name .. " (" .. (cur and cur.Name or "Combat") .. ")")
        pcall(function() hrp.CFrame = CFrame.lookAt(hrp.Position, Vector3.new(root.Position.X, hrp.Position.Y, root.Position.Z)) end)
        if os.clock() - pumpkinFarm.lastAttackTime >= CONFIG.ATTACK_COOLDOWN then
            pumpkinFarm.lastAttackTime = os.clock()
            fireRegisterAttack()
            fireRegisterHit(root)
        end
        if pumpkinFarm.attackStartedAt and os.clock() - pumpkinFarm.attackStartedAt > CONFIG.ATTACK_TIMEOUT then
            blacklistTarget(string.format("attack timeout %.0fs", CONFIG.ATTACK_TIMEOUT))
            return
        end
    end
end

