        local obj = findRemotePath(ReplicatedStorage, path)
        local name = table.concat(path, ".")
        if obj then
            present = present + 1
            if verbose then addLog("DIAG", "FOUND " .. name .. " (" .. obj.ClassName .. ")") end
        elseif verbose then
            addLog("DIAG", "MISSING " .. name)
        end
    end
    setFeatureStatus("diag", tostring(present) .. "/" .. tostring(#DIAG_PATHS) .. " remotes present")
end
local function diagStart() diagLast = 0; addLog("DIAG", "Remote diagnostics started."); runDiagnostics(true) end
