    local cur = char:FindFirstChildOfClass("Tool")
    if cur then
        local isM = isMeleeStyle(cur.Name)
        if (category == "Melee" and isM) or (category == "Sword" and not isM and not looksLikeFruitTool(cur.Name)) then return cur end
    end
