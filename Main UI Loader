-- =========================================================
local features = {}
local featureOrder = {}

updateSummary = function()
    local running = 0
    for _, id in ipairs(featureOrder) do
        local f = features[id]
        if f and f.running then running = running + 1 end
    end
    if summaryStatus then
        summaryStatus.Text = string.format(
            "%d running · %d lines · %d/s · %s",
            running, #logLines, pumpkinFarm.speed, pumpkinFarm.weaponCategory
        )
    end
end

local function setFeatureStatus(id, text)
    local f = features[id]
    if f and f.statusLabel then f.statusLabel.Text = tostring(text) end
end

local function refreshFeature(f)
    if not f then return end
    f.btn.Text = f.running and "Stop" or "Start"
    f.btn.BackgroundColor3 = f.running and Color3.fromRGB(90, 32, 52) or THEME.Button
    if f.statusLabel then
        f.statusLabel.TextColor3 = f.running and THEME.Green or THEME.Muted
    end
end

local function setFeatureRunning(id, running, silent)
    local f = features[id]
    if not f or f.running == running then return end
    f.running = running
    if running then
        if f.onStart then
            local ok, err = pcall(f.onStart)
            if not ok then
                addLog("ERROR", f.name .. " start failed: " .. tostring(err))
                f.running = false
            end
        end
    else
        if f.onStop then pcall(f.onStop) end
    end
    refreshFeature(f)
    updateSummary()
    if not silent then
        addLog("FEATURE", f.name .. " " .. (f.running and "started" or "stopped"))
    end
end

