-- =========================================================
RunService.RenderStepped:Connect(function(dt)
    if not pumpkinFarm.running then return end

    local char = player.Character
    if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hrp or not hum then return end

    -- Character changed (respawn): reset tracked parts, re-apply PlatformStand
    if hum ~= pumpkinFarm.lastHumanoid then
        pumpkinFarm.lastHumanoid = hum
        noclipParts = {}
        pcall(function() hum.PlatformStand = true end)
    end

    -- Auto noclip: track only parts we disabled
    for _, part in ipairs(char:GetChildren()) do
        if part:IsA("BasePart") and part.CanCollide then
            part.CanCollide = false
            noclipParts[part] = true
        end
    end

    -- Fly movement
    if pumpkinFarm.flyTarget then
        local offset = pumpkinFarm.flyTarget - hrp.Position
        local dist = offset.Magnitude
        if dist < 0.5 then
            pumpkinFarm.flyTarget = nil
        else
            local step = math.min(dist, pumpkinFarm.speed * dt)
            hrp.CFrame = hrp.CFrame + offset.Unit * step
        end
    end
end)

-- =========================================================
-- PUMPKIN FARM TICK (state machine, no movement here)
-- =========================================================
local function pumpkinFarmTick()
    local char = player.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not hrp then
        setFeatureStatus("pumpkin", "no character")
        return
    end

    -- Validate target
    if pumpkinFarm.currentPumpkin then
        local p = pumpkinFarm.currentPumpkin
        local r = pumpkinFarm.currentRoot
        if not p.Parent or not r or not r.Parent then
            addLog("PUMPKIN", "Target gone: " .. tostring(p.Name))
            pumpkinFarm.currentPumpkin = nil
            pumpkinFarm.currentRoot = nil
            pumpkinFarm.flyTarget = nil
        end
    end

    -- If no target, try to find one (respecting WAITING backoff)
    if not pumpkinFarm.currentPumpkin then
        if pumpkinFarm.state == "WAITING" and pumpkinFarm.lastRespawnAt then
            local remain = CONFIG.PUMPKIN_RESPAWN - (os.clock() - pumpkinFarm.lastRespawnAt)
            local sinceCheck = os.clock() - pumpkinFarm.lastWaitScanTime
            if remain > 0 and sinceCheck < CONFIG.WAITING_RESCAN then
                setFeatureStatus("pumpkin", string.format("respawn est. %02d:%02d", math.floor(remain/60), math.floor(remain%60)))
                return
            end
            pumpkinFarm.lastWaitScanTime = os.clock()
        end

        local p, r = findClosestPumpkin()
        if p and r then
            pumpkinFarm.currentPumpkin = p
            pumpkinFarm.currentRoot = r
            pumpkinFarm.state = "MOVING"
            pumpkinFarm.flyTarget = r.Position
            pumpkinFarm.lastRespawnAt = nil
            addLog("PUMPKIN", "Targeting " .. p.Name)
        else
            if pumpkinFarm.state ~= "WAITING" then
                pumpkinFarm.state = "WAITING"
                pumpkinFarm.lastRespawnAt = os.clock()
                pumpkinFarm.lastWaitScanTime = os.clock()
                addLog("PUMPKIN", "No pumpkins available. Waiting for respawn.")
            end
            pumpkinFarm.flyTarget = nil
            setFeatureStatus("pumpkin", "no pumpkins")
            return
        end
    end

    -- Act on target
    local root = pumpkinFarm.currentRoot
    local pumpkin = pumpkinFarm.currentPumpkin
    if not root or not pumpkin then return end

    local dist = (root.Position - hrp.Position).Magnitude
    if dist > CONFIG.TOUCH_DISTANCE then
        pumpkinFarm.flyTarget = root.Position
        pumpkinFarm.state = "MOVING"
        setFeatureStatus("pumpkin", string.format("flying (%.0f studs @ %d/s)", dist, pumpkinFarm.speed))
    else
        pumpkinFarm.flyTarget = nil
        pumpkinFarm.state = "ATTACKING"
        setFeatureStatus("pumpkin", "attacking " .. pumpkin.Name .. " (" .. getEquippedFightingStyle() .. ")")

        pcall(function()
            hrp.CFrame = CFrame.lookAt(hrp.Position, Vector3.new(root.Position.X, hrp.Position.Y, root.Position.Z))
        end)

        if os.clock() - pumpkinFarm.lastAttackTime >= CONFIG.ATTACK_COOLDOWN then
            pumpkinFarm.lastAttackTime = os.clock()
            local aOk = fireRegisterAttack()
            local hOk = fireRegisterHit(root)
            if not aOk and not hOk then
                addLog("PUMPKIN", "Attack remotes unavailable — cannot damage.")
                setFeatureStatus("pumpkin", "attack remotes missing")
            end
        end
    end
end

local function pumpkinFarmStart()
    if pumpkinFarm.running then return end
    pumpkinFarm.running = true
    pumpkinFarm.state = "IDLE"
    pumpkinFarm.currentPumpkin = nil
    pumpkinFarm.currentRoot = nil
    pumpkinFarm.flyTarget = nil
    pumpkinFarm.lastRespawnAt = nil
    pumpkinFarm.lastWaitScanTime = 0
    pumpkinFarm.lastAttackTime = 0
    pumpkinFarm.lastHumanoid = nil
    noclipParts = {}

    addLog("PUMPKIN", "Auto Pumpkin Farm started. Flying @ " .. pumpkinFarm.speed .. " studs/s. Auto-noclip ON.")
    pumpkinFarm.thread = task.spawn(function()
        while pumpkinFarm.running do
            pcall(pumpkinFarmTick)
            task.wait(0.1)
        end
    end)
end

local function stopPumpkinFarm()
    pumpkinFarm.running = false
    if pumpkinFarm.thread then
        pcall(function() task.cancel(pumpkinFarm.thread) end)
        pumpkinFarm.thread = nil
    end
    pumpkinFarm.flyTarget = nil
    pumpkinFarm.currentPumpkin = nil
    pumpkinFarm.currentRoot = nil
    pumpkinFarm.state = "IDLE"
    pumpkinFarm.lastRespawnAt = nil

    for part in pairs(noclipParts) do
        pcall(function()
            if part.Parent and part:IsA("BasePart") then
                part.CanCollide = true
            end
        end)
    end
    noclipParts = {}

    local char = player.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    if hum then
        pcall(function() hum.PlatformStand = false end)
    end
    pumpkinFarm.lastHumanoid = nil

    addLog("PUMPKIN", "Auto Pumpkin Farm stopped. Noclip OFF.")
end

