-- SAFE FLY
local function computeSafeFlyTarget(targetPos, pumpkinModel)
    local safeY = targetPos.Y + CONFIG.FLY_HOVER_HEIGHT
    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    local exclude = {}
    local char = player.Character
    if char then table.insert(exclude, char) end
    if pumpkinModel then table.insert(exclude, pumpkinModel) end
    params.FilterDescendantsInstances = exclude
    params.IgnoreWater = false
    params.RespectCanCollide = false
    local origin = Vector3.new(targetPos.X, targetPos.Y + 20, targetPos.Z)
    local ok, result = pcall(function() return Workspace:Raycast(origin, Vector3.new(0, -200, 0), params) end)
    if ok and result then
        local isWater = result.Material == Enum.Material.Water
        if not isWater and result.Instance then
            local n = result.Instance.Name:lower()
            if n:find("water", 1, true) or n:find("ocean", 1, true) then isWater = true end
        end
        if isWater then safeY = math.max(safeY, result.Position.Y + CONFIG.MIN_HEIGHT_ABOVE_WATER)
        else safeY = math.max(safeY, result.Position.Y + CONFIG.FLY_HOVER_HEIGHT) end
    end
    return Vector3.new(targetPos.X, safeY, targetPos.Z)
end

-- WEAPONS
local MELEE_STYLES = { "combat","dark step","electric","water kung fu","dragon breath","superhuman","death step","sharkman karate","electric claw","dragon talon","godhuman","sanguine art" }
local function isMeleeStyle(name)
    local n = tostring(name):lower()
    for _, s in ipairs(MELEE_STYLES) do if n:find(s, 1, true) then return true end end
    return false
end
local function equipWeaponOfCategory(category)
    local char = player.Character
    if not char then return nil end
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hum then return nil end
    local cur = char:FindFirstChildOfClass("Tool")
    if cur then
        local isM = isMeleeStyle(cur.Name)
        if (category == "Melee" and isM) or (category == "Sword" and not isM and not looksLikeFruit(cur.Name)) then return cur end
    end
    local bp = player:FindFirstChild("Backpack")
    if not bp then return nil end
    for _, tool in ipairs(bp:GetChildren()) do
        if tool:IsA("Tool") then
            local isM = isMeleeStyle(tool.Name)
            local isF = looksLikeFruit(tool.Name)
            local match = (category == "Melee" and isM) or (category == "Sword" and not isM and not isF)
            if match then pcall(function() hum:EquipTool(tool) end); return tool end
        end
    end
    return nil
end

-- NEAREST PUMPKIN
local function findClosestPumpkin()
    local hunt = Workspace:FindFirstChild("PumpkinHunt")
    if not hunt then return nil, nil, nil end
    local char = player.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not hrp then return nil, nil, nil end
    local now = os.clock()
    local best, bestDist, bestRoot = nil, math.huge, nil
    local ok, desc = pcall(function() return hunt:GetDescendants() end)
    if not ok then return nil, nil, nil end
    for _, d in ipairs(desc) do
        if d:IsA("Model") and d.Parent and d.Name:lower():find("pumpkin", 1, true) then
            local bl = pumpkinFarm.blacklist[d]
            if not (bl and bl > now) then
                local root = d:FindFirstChild("RootPart") or d:FindFirstChild("HumanoidRootPart")
                if root and root:IsA("BasePart") and root.Parent then
                    local dist = (root.Position - hrp.Position).Magnitude
                    if dist < bestDist then best, bestDist, bestRoot = d, dist, root end
                end
            end
        end
    end
    return best, bestRoot, bestDist
end
local function fireRegisterAttack()
    local r = getRegisterAttack()
    if not r then return false end
    return (pcall(function() r:FireServer(0.4000000059604645, 1) end))
end
local function fireRegisterHit(rootPart)
    local r = getRegisterHit()
    if not r or not rootPart then return false end
