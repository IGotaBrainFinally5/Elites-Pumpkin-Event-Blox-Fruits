-- FRUIT GUARD / EVADE state
local fruitGuardPaused = false
local lastEvadeCheck = 0

local function checkFruitGuard()
    if fruitGuardPaused then
        -- Check if fruit is gone
        if not fruitInInventory() then
            fruitGuardPaused = false
            setFeatureStatus("fruitguard", "clear — resuming")
            addLog("GUARD", "Fruit cleared. Resuming farm.")
