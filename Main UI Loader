local Players           = game:GetService("Players")
local CollectionService = game:GetService("CollectionService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService        = game:GetService("RunService")

local player = Players.LocalPlayer
local RequestQuest  = ReplicatedStorage:WaitForChild("RequestQuest")
local QuestUpdated  = ReplicatedStorage:WaitForChild("QuestUpdated")
local QuestProgress = ReplicatedStorage:WaitForChild("QuestProgress")
local AttackRequest = ReplicatedStorage:WaitForChild("AttackRequest")

local state = {
    AutoFarm       = false,
    AutoQuest      = false,
    SafeDistance   = 15,
    ActiveQuest    = nil,
    Progress       = 0,
    CurrentTarget  = nil,
    LastQuestCheck = 0,
    LastAttack     = 0,
}
_G.FarmState = state

local function getCharacter()
    local char = player.Character
    if not char then return end
    local hum = char:FindFirstChildOfClass("Humanoid")
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if hum and hrp and hum.Health > 0 then
        return char, hum, hrp
    end
end

-- Requirement #3: strict name match only.
local function findTarget(enemyName)
    local _, _, hrp = getCharacter()
    if not hrp then return end
    local best, bestDist = nil, math.huge
    for _, enemy in ipairs(CollectionService:GetTagged("FarmEnemy")) do
        if enemy:GetAttribute("EnemyName") == enemyName then
            local eHum  = enemy:FindFirstChildOfClass("Humanoid")
            local eRoot = enemy:FindFirstChild("HumanoidRootPart")
            if eHum and eRoot and eHum.Health > 0 then
                local d = (hrp.Position - eRoot.Position).Magnitude
                if d < bestDist then
                    best, bestDist = enemy, d
                end
            end
        end
    end
    return best, bestDist
end

QuestUpdated.OnClientEvent:Connect(function(quest, progress)
    state.ActiveQuest = quest
    state.Progress    = progress or 0
    state.LastQuestCheck = 0
    if _G.RefreshGUI then _G.RefreshGUI() end
end)

QuestProgress.OnClientEvent:Connect(function(progress, _total)
    state.Progress = progress
    if _G.RefreshGUI then _G.RefreshGUI() end
end)

RunService.Heartbeat:Connect(function()
    if not (state.AutoFarm or state.AutoQuest) then return end
    local _char, hum, hrp = getCharacter()
    if not hum then return end

    -- Requirement #2/#5: poll the server; it decides whether to
    -- replace the active quest (only if a higher-level one exists).
    if state.AutoQuest then
        local now = os.clock()
        if now - state.LastQuestCheck > 2 then
            state.LastQuestCheck = now
            local ok, result = pcall(function()
                return RequestQuest:InvokeServer()
            end)
            if ok and result and result.ok then
                state.ActiveQuest = result.quest
                state.Progress = 0
                if _G.RefreshGUI then _G.RefreshGUI() end
            end
        end
    end

    if not (state.AutoFarm and state.ActiveQuest) then return end

    -- Requirement #4: find target, approach, attack, re-target.
    local target, dist = findTarget(state.ActiveQuest.EnemyName)
    state.CurrentTarget = target

    if not target or not dist then
        hum:MoveTo(hrp.Position)   -- nothing to do; stand still
        return
    end

    local targetRoot = target.HumanoidRootPart

    if dist > state.SafeDistance then
        local dir  = (targetRoot.Position - hrp.Position).Unit
        local goal = targetRoot.Position - dir * state.SafeDistance
        goal = Vector3.new(goal.X, hrp.Position.Y, goal.Z)
        hum:MoveTo(goal)
    else
        hum:MoveTo(hrp.Position)   -- hold position at SafeDistance
        local now = os.clock()
        if now - state.LastAttack > 0.4 then
            state.LastAttack = now
            AttackRequest:FireServer(target)
        end
    end
end)


