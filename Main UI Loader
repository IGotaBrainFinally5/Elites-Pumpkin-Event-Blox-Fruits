    if not hunt then return nil, nil end
    local char = player.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not hrp then return nil, nil end

    local best, bestDist, bestRoot = nil, math.huge, nil
    local ok, descendants = pcall(function() return hunt:GetDescendants() end)
    if not ok then return nil, nil end

    for _, d in ipairs(descendants) do
        if d:IsA("Model") and d.Parent and d.Name:lower():find("pumpkin", 1, true) then
            local root = d:FindFirstChild("RootPart") or d:FindFirstChild("HumanoidRootPart")
            if root and root:IsA("BasePart") and root.Parent then
                local dist = (root.Position - hrp.Position).Magnitude
                if dist < bestDist then
                    best, bestDist, bestRoot = d, dist, root
                end
            end
        end
    end
    return best, bestRoot
end

