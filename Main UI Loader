RunService.RenderStepped:Connect(function(dt)
    if not pumpkinFarm.running then return end
    local char = player.Character
    if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hrp or not hum then return end

    if hum ~= pumpkinFarm.lastHumanoid then
        pumpkinFarm.lastHumanoid = hum
        noclipParts = {}
        pumpkinFarm.flyTarget = nil
        pumpkinFarm.currentPumpkin = nil
        pumpkinFarm.currentRoot = nil
        pumpkinFarm.stuckTime = 0
        pumpkinFarm.lastDistance = nil
        pumpkinFarm.lastY = nil
        pumpkinFarm.lastDy = nil
        pumpkinFarm.oscillationCount = 0
        pumpkinFarm.attackStartedAt = nil
        pumpkinFarm.weaponEquippedFor = nil
        pcall(function() hum.PlatformStand = true end)
    end

    for _, part in ipairs(char:GetChildren()) do
        if part:IsA("BasePart") and part.CanCollide then
            part.CanCollide = false
            noclipParts[part] = true
        end
    end

    if pumpkinFarm.flyTarget then
        local offset = pumpkinFarm.flyTarget - hrp.Position
        local dist = offset.Magnitude
        if dist < 0.5 then
            pumpkinFarm.flyTarget = nil
        else
            local step = math.min(dist, pumpkinFarm.speed * dt)
            hrp.CFrame = hrp.CFrame + offset.Unit * step
        end
        if os.clock() - pumpkinFarm.lastWaterCheck > CONFIG.WATER_CHECK_INTERVAL then
            pumpkinFarm.lastWaterCheck = os.clock()
            local waterY = getWaterHeightAt(hrp.Position.X, hrp.Position.Z)
            if waterY and hrp.Position.Y < waterY + CONFIG.MIN_HEIGHT_ABOVE_WATER then
                local liftTo = waterY + CONFIG.MIN_HEIGHT_ABOVE_WATER + 1
                hrp.CFrame = CFrame.new(hrp.Position.X, liftTo, hrp.Position.Z) * (hrp.CFrame - hrp.CFrame.Position)
                if pumpkinFarm.flyTarget then
                    pumpkinFarm.flyTarget = Vector3.new(pumpkinFarm.flyTarget.X, math.max(pumpkinFarm.flyTarget.Y, liftTo), pumpkinFarm.flyTarget.Z)
                end
            end
        end
    end
end)

-- =========================================================
-- PUMPKIN FARM TICK (fixed nearest logic)
-- =========================================================
local function resetStuckTracking()
    pumpkinFarm.stuckTime = 0
    pumpkinFarm.lastDistance = nil
    pumpkinFarm.lastY = nil
    pumpkinFarm.lastDy = nil
    pumpkinFarm.oscillationCount = 0
    pumpkinFarm.attackStartedAt = nil
end

local function setTarget(p, r, dist, reason)
    pumpkinFarm.currentPumpkin = p
    pumpkinFarm.currentRoot = r
    pumpkinFarm.lastSelectedDistance = dist
    resetStuckTracking()
    local safePos = computeSafeFlyTarget(r.Position)
    pumpkinFarm.flyTarget = safePos
    pumpkinFarm.state = "MOVING"
    pumpkinFarm.weaponEquippedFor = nil
    addLog("PUMPKIN", string.format("Selected %s @ %.1f studs (%s)", tostring(p.Name), dist or -1, reason or "?"))
end

local function blacklistTarget(reason)
    local p = pumpkinFarm.currentPumpkin
    if p then
        pumpkinFarm.blacklist[p] = os.clock() + CONFIG.BLACKLIST_DURATION
        addLog("PUMPKIN", string.format("Blacklisting %s for %ds (%s)", tostring(p.Name), CONFIG.BLACKLIST_DURATION, reason))
    end
    pumpkinFarm.currentPumpkin = nil
    pumpkinFarm.currentRoot = nil
    pumpkinFarm.flyTarget = nil
    pumpkinFarm.weaponEquippedFor = nil
    resetStuckTracking()
end

local function pumpkinFarmTick()
    local char = player.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not hrp then
        setFeatureStatus("pumpkin", "no character")
        return
    end

    -- prune blacklist
    local now = os.clock()
    for k, v in pairs(pumpkinFarm.blacklist) do
        if v < now or not k.Parent then pumpkinFarm.blacklist[k] = nil end
    end

    -- Validate current target
    if pumpkinFarm.currentPumpkin then
        local p = pumpkinFarm.currentPumpkin
        local r = pumpkinFarm.currentRoot
        if not p.Parent or not r or not r.Parent then
            -- Possible kill detection: if we were attacking this target, count it
            if pumpkinFarm.state == "ATTACKING" then
                stats.pumpkinsFarmed = stats.pumpkinsFarmed + 1
                pumpkinFarm.lastKillTime = os.clock()
                addLog("PUMPKIN", string.format("Target disappeared while attacking. Pumpkins farmed: %d", stats.pumpkinsFarmed))
                if refreshStatsTab then refreshStatsTab() end
            else
                addLog("PUMPKIN", "Target gone (was not attacking)")
            end
            pumpkinFarm.currentPumpkin = nil
            pumpkinFarm.currentRoot = nil
            pumpkinFarm.flyTarget = nil
            pumpkinFarm.weaponEquippedFor = nil
            resetStuckTracking()
            -- fall through to acquire immediately
        end
    end

    -- Acquire target if none — no 5s gate; scan every tick
    if not pumpkinFarm.currentPumpkin then
        local p, r, dist = findClosestPumpkin()
        if p and r then
            setTarget(p, r, dist, "nearest")
            pumpkinFarm.lastRespawnAt = nil
        else
            pumpkinFarm.state = "WAITING"
            pumpkinFarm.flyTarget = nil
            if not pumpkinFarm.lastRespawnAt then
                pumpkinFarm.lastRespawnAt = os.clock()
                addLog("PUMPKIN", "No pumpkins available. Waiting.")
            end
            local elapsed = os.clock() - pumpkinFarm.lastRespawnAt
            setFeatureStatus("pumpkin", string.format("waiting (%.0fs)", elapsed))
            return
        end
    end

    -- During MOVING: if a closer pumpkin appears, switch
    local root = pumpkinFarm.currentRoot
    local pumpkin = pumpkinFarm.currentPumpkin
    if not root or not pumpkin then return end

    local dist = (root.Position - hrp.Position).Magnitude

    if pumpkinFarm.state == "MOVING" and dist > CONFIG.SWITCH_MIN_DIST then
        local np, nr, ndist = findClosestPumpkin()
        if np and np ~= pumpkin and ndist and ndist < dist - CONFIG.SWITCH_MARGIN then
            addLog("PUMPKIN", string.format("Switching to closer pumpkin (%.1f < %.1f)", ndist, dist))
            setTarget(np, nr, ndist, "closer")
            return
        end
    end

    -- Throttled diagnostic
    if os.clock() - pumpkinFarm.lastDistLog > CONFIG.TARGET_DIST_LOG_INTERVAL then
        pumpkinFarm.lastDistLog = os.clock()
        addLog("PUMPKIN", string.format("Current target %s: %.1f studs", tostring(pumpkin.Name), dist))
    end

    -- Progress tracking (only during MOVING)
    if pumpkinFarm.state == "MOVING" then
        if pumpkinFarm.lastDistance then
            local delta = pumpkinFarm.lastDistance - dist
            if delta < CONFIG.PROGRESS_THRESHOLD then
                pumpkinFarm.stuckTime = pumpkinFarm.stuckTime + CONFIG.STUCK_TICK_DT
            else
                pumpkinFarm.stuckTime = 0
            end
        end
        pumpkinFarm.lastDistance = dist

        -- Oscillation
        if pumpkinFarm.lastY then
            local dy = hrp.Position.Y - pumpkinFarm.lastY
            if pumpkinFarm.lastDy and math.abs(dy) > 0.1 and math.abs(pumpkinFarm.lastDy) > 0.1 then
                if (dy > 0) ~= (pumpkinFarm.lastDy > 0) then
                    pumpkinFarm.oscillationCount = pumpkinFarm.oscillationCount + 1
                end
            end
            pumpkinFarm.lastDy = dy
        end
        pumpkinFarm.lastY = hrp.Position.Y

        if pumpkinFarm.stuckTime >= CONFIG.STUCK_TIMEOUT then
            blacklistTarget(string.format("no progress %.1fs", pumpkinFarm.stuckTime))
            return
        end
        if pumpkinFarm.oscillationCount >= CONFIG.OSCILLATION_THRESHOLD then
            blacklistTarget(string.format("Y-osc x%d", pumpkinFarm.oscillationCount))
            return
        end
    end

    if dist > CONFIG.TOUCH_DISTANCE then
        if not pumpkinFarm.flyTarget then
            pumpkinFarm.flyTarget = computeSafeFlyTarget(root.Position)
        end
        pumpkinFarm.state = "MOVING"
        setFeatureStatus("pumpkin", string.format("flying %.0f @ %d/s", dist, pumpkinFarm.speed))
    else
        pumpkinFarm.flyTarget = nil
        if pumpkinFarm.state ~= "ATTACKING" then
            pumpkinFarm.state = "ATTACKING"
            pumpkinFarm.attackStartedAt = os.clock()
        end

        if pumpkinFarm.weaponEquippedFor ~= pumpkin then
            local equipped = equipWeaponOfCategory(pumpkinFarm.weaponCategory)
            pumpkinFarm.weaponEquippedFor = pumpkin
            if equipped then
                addLog("WEAPON", "Equipped: " .. equipped.Name .. " (" .. pumpkinFarm.weaponCategory .. ")")
            else
                addLog("WEAPON", "No tool matched " .. pumpkinFarm.weaponCategory .. "; keeping current.")
            end
        end

        local currentTool = char and char:FindFirstChildOfClass("Tool")
        local style = currentTool and currentTool.Name or "Combat"
        setFeatureStatus("pumpkin", "attacking " .. pumpkin.Name .. " (" .. style .. ")")

        pcall(function()
            hrp.CFrame = CFrame.lookAt(hrp.Position, Vector3.new(root.Position.X, hrp.Position.Y, root.Position.Z))
        end)

        if os.clock() - pumpkinFarm.lastAttackTime >= CONFIG.ATTACK_COOLDOWN then
            pumpkinFarm.lastAttackTime = os.clock()
            local aOk = fireRegisterAttack()
            local hOk = fireRegisterHit(root)
            if not aOk and not hOk then
                addLog("PUMPKIN", "Attack remotes unavailable.")
                setFeatureStatus("pumpkin", "attack remotes missing")
            end
        end

        -- Attack timeout: if we've been adjacent for too long without the pumpkin disappearing,
        -- assume server is rejecting hits and try another target.
        if pumpkinFarm.attackStartedAt and os.clock() - pumpkinFarm.attackStartedAt > CONFIG.ATTACK_TIMEOUT then
            blacklistTarget(string.format("attack timeout %.0fs", CONFIG.ATTACK_TIMEOUT))
            return
        end
    end
end

local function pumpkinFarmStart()
    if pumpkinFarm.running then return end
    pumpkinFarm.running = true
    pumpkinFarm.state = "IDLE"
    pumpkinFarm.currentPumpkin = nil
    pumpkinFarm.currentRoot = nil
    pumpkinFarm.flyTarget = nil
    pumpkinFarm.lastRespawnAt = nil
    pumpkinFarm.lastAttackTime = 0
    pumpkinFarm.lastHumanoid = nil
    pumpkinFarm.lastWaterCheck = 0
    pumpkinFarm.weaponEquippedFor = nil
    pumpkinFarm.lastDistLog = 0
    resetStuckTracking()
    noclipParts = {}
    addLog("PUMPKIN", string.format("Started. Fly %d/s, weapon %s.", pumpkinFarm.speed, pumpkinFarm.weaponCategory))
    pumpkinFarm.thread = task.spawn(function()
        while pumpkinFarm.running do
            pcall(pumpkinFarmTick)
            task.wait(0.1)
        end
    end)
end

local function stopPumpkinFarm()
    pumpkinFarm.running = false
    if pumpkinFarm.thread then
        pcall(function() task.cancel(pumpkinFarm.thread) end)
        pumpkinFarm.thread = nil
    end
    pumpkinFarm.flyTarget = nil
    pumpkinFarm.currentPumpkin = nil
    pumpkinFarm.currentRoot = nil
    pumpkinFarm.state = "IDLE"
    pumpkinFarm.lastRespawnAt = nil
    pumpkinFarm.weaponEquippedFor = nil
    resetStuckTracking()
    for part in pairs(noclipParts) do
        pcall(function()
            if part.Parent and part:IsA("BasePart") then part.CanCollide = true end
        end)
    end
    noclipParts = {}
    local char = player.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    if hum then pcall(function() hum.PlatformStand = false end) end
    pumpkinFarm.lastHumanoid = nil
    addLog("PUMPKIN", "Stopped.")
end

