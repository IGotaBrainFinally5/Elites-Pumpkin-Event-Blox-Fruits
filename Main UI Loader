local function getNet()
    local modules = ReplicatedStorage:FindFirstChild("Modules")
    if not modules then
        return nil
    end
    return modules:FindFirstChild("Net")
end

local function findRemotePath(root, path)
    local cur = root
    for _, name in ipairs(path) do
        if not cur then
            return nil
        end
        cur = cur:FindFirstChild(name)
    end
    return cur
end

local function getGachaRF()
    local net = getNet()
    return net and net:FindFirstChild("RF/GachaNetworkRF")
end

-- =========================================================
-- Pumpkin tracker
-- =========================================================

local pumpkinSeen = {}
local pumpkinLastCount = 0
local respawnEndsAt = nil
local respawnNotified = true

local function scanPumpkins()
    local list = {}
    local hunt = Workspace:FindFirstChild("PumpkinHunt")
    if hunt then
        for _, d in ipairs(hunt:GetDescendants()) do
            if d:IsA("Model") and d.Name:lower():find("pumpkin", 1, true) then
                table.insert(list, d)
            end
        end
    end
    return list
end

local function pumpkinStart()
    pumpkinSeen = {}
    pumpkinLastCount = 0
    addLog("PUMPKIN", "Pumpkin tracker started. Watching workspace.PumpkinHunt.")
end

local function pumpkinTick()
    local list = scanPumpkins()
    local now = {}
    for _, obj in ipairs(list) do
        now[obj] = true
        if not pumpkinSeen[obj] then
            addLog("PUMPKIN", "Detected " .. obj:GetFullName())
        end
    end

    for obj in pairs(pumpkinSeen) do
        if not now[obj] then
            addLog("PUMPKIN", "No longer visible: " .. tostring(obj.Name))
        end
    end

    local oldCount = pumpkinLastCount
    pumpkinSeen = now
    pumpkinLastCount = #list

    setFeatureStatus("pumpkin", tostring(#list) .. " pumpkin model(s) visible")

    if #list < oldCount then
        respawnEndsAt = os.clock() + CONFIG.OBSERVED_PUMPKIN_RESPAWN
        respawnNotified = false
        addLog("RESPAWN", "Pumpkin disappeared. Local estimate timer set to 690s (observed, not server-confirmed).")
    end
end

-- =========================================================
-- Material scanner
-- =========================================================

local MATERIAL_KEYWORDS = { "candy", "corn", "pumpkin", "bit", "seed", "treat", "halloween", "spooky", "soul", "bone" }

local function hasMaterialKeyword(name)
    local s = tostring(name):lower()
    for _, k in ipairs(MATERIAL_KEYWORDS) do
        if s:find(k, 1, true) then
            return true
        end
    end
    return false
end

local function collectMaterials()
    local out = {}

    local function add(name, value)
        if hasMaterialKeyword(name) and type(value) == "number" then
            out[name] = value
        end
    end

    for k, v in pairs(player:GetAttributes()) do
        add("attr." .. tostring(k), v)
    end

    local leaderstats = player:FindFirstChild("leaderstats")
    if leaderstats then
        for _, c in ipairs(leaderstats:GetChildren()) do
            if c:IsA("ValueBase") then
                add("leaderstats." .. c.Name, c.Value)
            end
        end
    end

    local containers = { player:FindFirstChild("Backpack"), player.Character }
    for _, cont in ipairs(containers) do
        if cont then
            for _, child in ipairs(cont:GetChildren()) do
                if child:IsA("Tool") and hasMaterialKeyword(child.Name) then
                    local key = "tool." .. child.Name
                    out[key] = (out[key] or 0) + 1
                end
            end
        end
    end

    return out
end

local function materialString(tbl)
    local keys = {}
    for k in pairs(tbl) do
        table.insert(keys, k)
    end
    table.sort(keys)
    local parts = {}
    for _, k in ipairs(keys) do
        table.insert(parts, tostring(k) .. "=" .. tostring(tbl[k]))
    end
    return table.concat(parts, ", ")
end

local materialSnapshot = nil

local function materialStart()
    materialSnapshot = nil
    addLog("MATERIAL", "Material scanner started. Reading only client-visible attributes, leaderstats, and tools.")
end

local function materialTick()
    local snap = collectMaterials()
    local str = materialString(snap)

    if not materialSnapshot then
        addLog("MATERIAL", "Initial readable materials: " .. (str ~= "" and str or "none"))
        materialSnapshot = snap
    elseif materialString(materialSnapshot) ~= str then
        addLog("MATERIAL", "Material changes: " .. (str ~= "" and str or "none"))
        materialSnapshot = snap
    end

    local count = 0
    for _ in pairs(snap) do
        count = count + 1
    end
    setFeatureStatus("materials", tostring(count) .. " readable value(s)")
end

-- =========================================================
-- Event keyword observer
-- =========================================================

local EVENT_KEYWORDS = { "trick", "treat", "dapper", "cursed", "seed", "spooky", "jack", "pumpkin", "halloween" }
local eventLast = {}

local function scanEventObjects()
    local roots = {}
    local function addRoot(name)
        local r = Workspace:FindFirstChild(name)
        if r then
            table.insert(roots, r)
        end
    end

    addRoot("PumpkinHunt")
    addRoot("NPCs")
    addRoot("Halloween")

    if #roots == 0 then
        table.insert(roots, Workspace)
    end

    local found = {}
    for _, root in ipairs(roots) do
        local ok, descendants = pcall(function()
            return root:GetDescendants()
        end)
        if ok then
            for _, d in ipairs(descendants) do
                local n = d.Name:lower()
                for _, k in ipairs(EVENT_KEYWORDS) do
                    if n:find(k, 1, true) then
                        found[d] = d.ClassName .. ":" .. d.Name
                        break
                    end
                end
            end
        end
    end
    return found
end

local function eventStart()
    eventLast = {}
    addLog("EVENT", "Event keyword observer started. Best-effort local name scan only.")
end

local function eventTick()
    local found = scanEventObjects()

    for obj, desc in pairs(found) do
        if not eventLast[obj] then
            addLog("EVENT", "Detected " .. desc)
        end
    end

    for obj, desc in pairs(eventLast) do
        if not found[obj] then
            addLog("EVENT", "No longer visible " .. desc)
        end
    end

    eventLast = found

    local count = 0
    for _ in pairs(found) do
        count = count + 1
    end
    setFeatureStatus("events", tostring(count) .. " keyword object(s)")
end

-- =========================================================
-- Gacha monitor and manual probe
-- =========================================================

local gachaLastPresent = nil

local function invokeGachaContext(context)
    local rf = getGachaRF()
    if not rf then
        addLog("GACHA", "RF/GachaNetworkRF is missing. Cannot call " .. tostring(context))
        return false
    end

    local payload = {
        Context = context,
        BoxName = CONFIG.GACHA_BOX,
    }

    local ok, res = pcall(function()
        if rf:IsA("RemoteFunction") then
            return rf:InvokeServer(payload)
        elseif rf:IsA("RemoteEvent") then
            rf:FireServer(payload)
            return "fired"
        else
            error("Unsupported remote class: " .. rf.ClassName)
        end
    end)

    if ok then
        addLog("GACHA", tostring(context) .. " -> " .. fmt(res))
        return true, res
    else
        addLog("ERROR", "Gacha " .. tostring(context) .. " failed: " .. tostring(res))
        return false
    end
end

local function probeGacha()
    addLog("GACHA", "Probing Halloween26Gacha with GetPityData and Check. No purchase is made.")
    invokeGachaContext("GetPityData")
    task.wait(0.3)
    invokeGachaContext("Check")
end

local function gachaStart()
    gachaLastPresent = nil
    addLog("GACHA", "Halloween Gacha monitor started. It only checks remote presence and manual probes.")
end

local function gachaTick()
    local present = getGachaRF() ~= nil
    if present ~= gachaLastPresent then
        gachaLastPresent = present
        addLog("GACHA", present and "RF/GachaNetworkRF is present." or "RF/GachaNetworkRF is missing.")
    end
    setFeatureStatus("gacha", present and "remote present" or "remote missing")
end

local purchaseConfirmUntil = 0

local function requestGachaPurchase()
    if os.clock() < purchaseConfirmUntil then
        purchaseConfirmUntil = 0
        addLog("GACHA", "Manual Purchase requested. The server will validate Candy Corn and arguments.")
        invokeGachaContext("Purchase")
    else
        purchaseConfirmUntil = os.clock() + 5
        addLog("WARN", "Gacha purchase confirmation: tap Buy Gacha again within 5 seconds. This may spend 500 Candy Corn if the server accepts it.")
    end
end

