-- =========================================================
-- AUTO PUMPKIN FARM (PRIORITY 1)
-- =========================================================
local pumpkinFarm = {
    running = false,
    thread = nil,
    state = "IDLE", -- IDLE / MOVING / ATTACKING / WAITING
    currentPumpkin = nil,
    currentRoot = nil,
    lastMoveTime = 0,
    lastAttackTime = 0,
    lastRespawnAt = nil,
}

local function findClosestPumpkin()
    local hunt = Workspace:FindFirstChild("PumpkinHunt")
    if not hunt then return nil, nil end

    local char = player.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not hrp then return nil, nil end

    local best, bestDist = nil, math.huge
    local bestRoot = nil

    -- Only iterate direct children and named descendants, not full GetDescendants on huge workspace
    local ok, descendants = pcall(function() return hunt:GetDescendants() end)
    if not ok then return nil, nil end

    for _, d in ipairs(descendants) do
        if d:IsA("Model") and d.Name:lower():find("pumpkin", 1, true) then
            local root = d:FindFirstChild("RootPart") or d:FindFirstChild("HumanoidRootPart")
            if root and root:IsA("BasePart") then
                local dist = (root.Position - hrp.Position).Magnitude
                if dist < bestDist then
                    best, bestDist, bestRoot = d, dist, root
                end
            end
        end
    end
    return best, bestRoot
end

local function getEquippedFightingStyle()
    local char = player.Character
    if not char then return "Combat" end
    local tool = char:FindFirstChildOfClass("Tool")
    if tool then
        local n = tool.Name:lower()
        local styles = {
            "combat", "dark step", "electric", "water kung fu",
            "dragon breath", "superhuman", "death step",
            "sharkman karate", "electric claw", "dragon talon",
            "godhuman", "sanguine art",
        }
        for _, s in ipairs(styles) do
            if n:find(s, 1, true) then return tool.Name end
        end
    end
    return "Combat"
end

local function fireRegisterAttack()
    local remote = getRegisterAttack()
    if not remote then return false end
    local ok = pcall(function()
        remote:FireServer(0.4000000059604645, 1)
    end)
    return ok
end

local function fireRegisterHit(rootPart)
    local remote = getRegisterHit()
    if not remote or not rootPart then return false end
    local ok = pcall(function()
        remote:FireServer(rootPart)
    end)
    return ok
end

local function stopPumpkinFarm()
    pumpkinFarm.running = false
    if pumpkinFarm.thread then
        pcall(function() task.cancel(pumpkinFarm.thread) end)
        pumpkinFarm.thread = nil
    end
    pumpkinFarm.state = "IDLE"
    pumpkinFarm.currentPumpkin = nil
    pumpkinFarm.currentRoot = nil
    addLog("PUMPKIN", "Auto Pumpkin Farm stopped.")
end

local function pumpkinFarmStart()
    if pumpkinFarm.running then return end
    pumpkinFarm.running = true
    pumpkinFarm.state = "IDLE"
    addLog("PUMPKIN", "Auto Pumpkin Farm started. Best-effort: navigation + captured attack remotes.")
    pumpkinFarm.thread = task.spawn(function()
        while pumpkinFarm.running do
            local char = player.Character
            local hrp = char and char:FindFirstChild("HumanoidRootPart")
            local hum = char and char:FindFirstChildOfClass("Humanoid")

            if not hrp or not hum then
                setFeatureStatus("pumpkin", "no character")
                task.wait(1)
            else
                if pumpkinFarm.state == "WAITING" then
                    local remain = CONFIG.PUMPKIN_RESPAWN - (os.clock() - (pumpkinFarm.lastRespawnAt or 0))
                    if remain > 0 then
                        setFeatureStatus("pumpkin", string.format("respawn in %02d:%02d", math.floor(remain/60), math.floor(remain%60)))
                    else
                        pumpkinFarm.state = "IDLE"
                        pumpkinFarm.lastRespawnAt = nil
                    end
                elseif pumpkinFarm.state == "IDLE" or pumpkinFarm.state == "MOVING" then
                    local pumpkin, root = findClosestPumpkin()
                    if not pumpkin or not root then
                        setFeatureStatus("pumpkin", "no pumpkin found — waiting")
                        task.wait(2)
                    else
                        pumpkinFarm.currentPumpkin = pumpkin
                        pumpkinFarm.currentRoot = root
                        local dist = (root.Position - hrp.Position).Magnitude
                        if dist <= CONFIG.TOUCH_DISTANCE then
                            pumpkinFarm.state = "ATTACKING"
                            setFeatureStatus("pumpkin", "attacking " .. pumpkin.Name)
                        else
                            pumpkinFarm.state = "MOVING"
                            setFeatureStatus("pumpkin", string.format("moving (%.0f studs)", dist))
                            -- Re-issue MoveTo every few seconds
                            if os.clock() - pumpkinFarm.lastMoveTime > CONFIG.MOVE_RETRY_TIME then
                                pumpkinFarm.lastMoveTime = os.clock()
                                local ok = pcall(function()
                                    hum:MoveTo(root.Position)
                                end)
                                if not ok then
                                    addLog("PUMPKIN", "MoveTo failed.")
                                end
                            end
                        end
                    end
                elseif pumpkinFarm.state == "ATTACKING" then
                    local root = pumpkinFarm.currentRoot
                    local pumpkin = pumpkinFarm.currentPumpkin
                    if not root or not pumpkin or not pumpkin.Parent then
                        -- Pumpkin disappeared — start respawn timer
                        addLog("PUMPKIN", "Pumpkin disappeared. Starting 690s respawn estimate.")
                        pumpkinFarm.state = "WAITING"
                        pumpkinFarm.lastRespawnAt = os.clock()
                        pumpkinFarm.currentPumpkin = nil
                        pumpkinFarm.currentRoot = nil
                        setFeatureStatus("pumpkin", "respawn timer started")
                    else
                        -- Face pumpkin and attack
                        local dist = (root.Position - hrp.Position).Magnitude
                        if dist > CONFIG.TOUCH_DISTANCE * 1.5 then
                            pumpkinFarm.state = "MOVING"
                        else
                            local style = getEquippedFightingStyle()
                            setFeatureStatus("pumpkin", "attacking (" .. style .. ")")
                            if os.clock() - pumpkinFarm.lastAttackTime >= CONFIG.ATTACK_COOLDOWN then
                                pumpkinFarm.lastAttackTime = os.clock()
                                -- 1. Orient character
                                pcall(function()
                                    hrp.CFrame = CFrame.lookAt(hrp.Position, Vector3.new(root.Position.X, hrp.Position.Y, root.Position.Z))
                                end)
                                -- 2. Fire captured attack registration
                                local attackOk = fireRegisterAttack()
                                -- 3. Fire captured hit registration
                                local hitOk = fireRegisterHit(root)
                                if not attackOk and not hitOk then
                                    -- Both remotes missing or failed; do not spam
                                    addLog("PUMPKIN", "Attack remotes unavailable. Cannot auto-damage.")
                                    setFeatureStatus("pumpkin", "attack remotes missing")
                                end
                            end
                        end
                    end
                end
            end
            task.wait(0.1)
        end
    end)
end

