local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local CONFIG = {
    PUMPKIN_HEALTH = 100,
    PUMPKIN_DAMAGE = 25,
    PUMPKIN_CANDY = 100,
    PUMPKIN_BITS = 10,

    SPECIAL_HEALTH = 250,
    SPECIAL_CANDY = 250,
    SPECIAL_BITS = 25,

    PUMPKIN_RESPAWN = 690,

    GACHA_COST = 500,
    ROLLS_PER_HOUR = 2,
    ROLL_WINDOW = 3600,

    FARM_INTERVAL = 0.4,
}

local random = Random.new()
local data = {}
local loops = {}

-- Remote setup
local folder = ReplicatedStorage:FindFirstChild("HalloweenFarmRemotes")
if not folder then
    folder = Instance.new("Folder")
    folder.Name = "HalloweenFarmRemotes"
    folder.Parent = ReplicatedStorage
end

local function remote(className, name)
    local obj = folder:FindFirstChild(name)
    if not obj then
        obj = Instance.new(className)
        obj.Name = name
        obj.Parent = folder
    end
    return obj
end

local Action = remote("RemoteEvent", "Action")
local Update = remote("RemoteEvent", "Update")
local GetState = remote("RemoteFunction", "GetState")

local enemies = workspace:FindFirstChild("HalloweenEnemies")
if not enemies then
    enemies = Instance.new("Folder")
    enemies.Name = "HalloweenEnemies"
    enemies.Parent = workspace
end

local fruitPool = {
    "Rocket", "Spin", "Chop", "Spring", "Bomb",
    "Smoke", "Spike", "Flame", "Sand", "Ice",
    "Dark", "Light", "Magma", "Buddha", "Portal",
}

local function getData(player)
    if not data[player] then
        data[player] = {
            Candy = 0,
            Bits = 0,
            Defeated = 0,
            Seeds = 0,
            Fruits = {},
            Stored = {},
            RollTimes = {},
            Running = false,
            Paused = false,
            Status = "Stopped",
            NextPumpkin = 0,
            Generation = 0,
        }
    end
    return data[player]
end

local function update(player, message)
    local d = getData(player)

    Update:FireClient(player, {
        Candy = d.Candy,
        Bits = d.Bits,
        Defeated = d.Defeated,
        Seeds = d.Seeds,
        Fruits = d.Fruits,
        Stored = d.Stored,
        Rolls = #d.RollTimes,
        Status = d.Status,
        NextPumpkin = d.NextPumpkin,
        Message = message or "",
    })
end

local function reward(player, candy, bits)
    local d = getData(player)
    d.Candy += candy
    d.Bits = math.min(1000, d.Bits + bits)
end

local function removeEnemies(player)
    for _, enemy in ipairs(enemies:GetChildren()) do
        if enemy:GetAttribute("Owner") == player.UserId then
            enemy:Destroy()
        end
    end
end

local function spawnEnemy(player, special)
    local character = player.Character
    local root = character and character:FindFirstChild("HumanoidRootPart")
    local origin = root and root.Position or Vector3.new(0, 5, 0)

    local enemy = Instance.new("Part")
    enemy.Name = special and "Jack-o-lantern" or "Pumpkin"
    enemy.Shape = Enum.PartType.Ball
    enemy.Anchored = true
    enemy.CanCollide = false
    enemy.Material = Enum.Material.Neon
    enemy.Color = special
        and Color3.fromRGB(255, 65, 15)
        or Color3.fromRGB(255, 145, 20)

    enemy.Size = special
        and Vector3.new(7, 7, 7)
        or Vector3.new(5, 5, 5)

    enemy.Position = origin + Vector3.new(
        random:NextInteger(-15, 15),
        3,
        random:NextInteger(-15, 15)
    )

    enemy:SetAttribute("Owner", player.UserId)
    enemy:SetAttribute(
        "Health",
        special and CONFIG.SPECIAL_HEALTH or CONFIG.PUMPKIN_HEALTH
    )

    enemy.Parent = enemies

    local billboard = Instance.new("BillboardGui")
    billboard.Size = UDim2.fromOffset(170, 35)
    billboard.StudsOffset = Vector3.new(0, 4, 0)
    billboard.AlwaysOnTop = true
    billboard.Parent = enemy

    local text = Instance.new("TextLabel")
    text.Size = UDim2.fromScale(1, 1)
    text.BackgroundTransparency = 1
    text.TextColor3 = Color3.new(1, 1, 1)
    text.TextStrokeTransparency = 0
    text.Font = Enum.Font.GothamBold
    text.TextScaled = true
    text.Parent = billboard

    local function refresh()
        text.Text = enemy.Name .. " | HP: "
            .. tostring(enemy:GetAttribute("Health"))
    end

    refresh()
    return enemy, refresh
end

local function waitUntilActive(player, generation)
    local d = getData(player)

    while player.Parent
        and d.Running
        and d.Generation == generation
        and d.Paused do
        task.wait(0.2)
    end

    return player.Parent
        and d.Running
        and d.Generation == generation
end

local function fight(player, enemy, refresh, generation)
    local d = getData(player)

    while enemy.Parent and d.Running
        and d.Generation == generation do

        if not waitUntilActive(player, generation) then
            break
        end

        local health = enemy:GetAttribute("Health") or 0
        health -= CONFIG.PUMPKIN_DAMAGE
        enemy:SetAttribute("Health", math.max(0, health))
        refresh()

        if health <= 0 then
            enemy:Destroy()
            return true
        end

        task.wait(CONFIG.FARM_INTERVAL)
    end

    return false
end

local function fightSpecial(player, generation)
    local d = getData(player)
    local enemy, refresh = spawnEnemy(player, true)

    update(player, "Jack-o-lantern appeared!")

    if fight(player, enemy, refresh, generation) then
        reward(player, CONFIG.SPECIAL_CANDY, CONFIG.SPECIAL_BITS)
        d.Seeds += 1
        update(player, "Jack-o-lantern defeated! +1 Cursed Seed.")
    end
end

local function farm(player, generation)
    local d = getData(player)

    while player.Parent and d.Running
        and d.Generation == generation do

        if not waitUntilActive(player, generation) then
            break
        end

        local remaining = d.NextPumpkin - os.time()

        if remaining > 0 then
            update(player, "Pumpkin respawning: " .. remaining .. " seconds")
            task.wait(1)
        else
            local enemy, refresh = spawnEnemy(player, false)
            update(player, "Pumpkin found! Attacking...")

            if fight(player, enemy, refresh, generation) then
                d.Defeated += 1
                reward(player, CONFIG.PUMPKIN_CANDY, CONFIG.PUMPKIN_BITS)

                d.NextPumpkin = os.time() + CONFIG.PUMPKIN_RESPAWN

                update(player, "Pumpkin defeated! Rewards collected.")

                if d.Defeated % 3 == 0 then
                    fightSpecial(player, generation)
                end
            else
                if enemy.Parent then
                    enemy:Destroy()
                end
            end
        end
    end
end

local function cleanRolls(d)
    local now = os.time()

    for i = #d.RollTimes, 1, -1 do
        if now - d.RollTimes[i] >= CONFIG.ROLL_WINDOW then
            table.remove(d.RollTimes, i)
        end
    end
end

local function roll(player)
    local d = getData(player)
    cleanRolls(d)

    if #d.RollTimes >= CONFIG.ROLLS_PER_HOUR then
        update(player, "Two-roll hourly limit reached.")
        return
    end

    if d.Candy < CONFIG.GACHA_COST then
        update(player, "Not enough Candy Corn.")
        return
    end

    d.Candy -= CONFIG.GACHA_COST
    table.insert(d.RollTimes, os.time())

    local fruit = fruitPool[random:NextInteger(1, #fruitPool)]
    table.insert(d.Fruits, fruit)

    update(player, "Gacha result: " .. fruit .. " Fruit!")
end

local function store(player, fruit)
    local d = getData(player)

    if typeof(fruit) ~= "string" then return end

    local index = table.find(d.Fruits, fruit)
    if not index then
        update(player, "Fruit not found in inventory.")
        return
    end

    table.remove(d.Fruits, index)
    table.insert(d.Stored, fruit)
    update(player, "Stored " .. fruit .. " Fruit.")
end

Action.OnServerEvent:Connect(function(player, action, value)
    local d = getData(player)

    if action == "Start" then
        if not d.Running then
            d.Running = true
            d.Paused = false
            d.Status = "Farming"
            d.Generation += 1

            local generation = d.Generation
            update(player, "Farm started!")

            task.spawn(farm, player, generation)
        elseif d.Paused then
            d.Paused = false
            d.Status = "Farming"
            update(player, "Farm resumed.")
        end

    elseif action == "Pause" then
        if d.Running then
            d.Paused = true
            d.Status = "Paused"
            update(player, "Farm paused.")
        end

    elseif action == "Stop" then
        d.Running = false
        d.Paused = false
        d.Status = "Stopped"
        d.Generation += 1
        removeEnemies(player)
        update(player, "Farm stopped.")

    elseif action == "Roll" then
        roll(player)

    elseif action == "Store" then
        store(player, value)
    end
end)

GetState.OnServerInvoke = function(player)
    local d = getData(player)
    return {
        Candy = d.Candy,
        Bits = d.Bits,
        Defeated = d.Defeated,
        Seeds = d.Seeds,
        Fruits = d.Fruits,
        Stored = d.Stored,
        Rolls = #d.RollTimes,
        Status = d.Status,
        NextPumpkin = d.NextPumpkin,
    }
end

Players.PlayerRemoving:Connect(function(player)
    removeEnemies(player)
    data[player] = nil
end)

