local Players = game:GetService("Players")
local player  = Players.LocalPlayer

-- FarmController publishes state; wait for it (load order isn't guaranteed).
local function waitForState()
    local t = 0
    while not _G.FarmState and t < 10 do
        task.wait(0.1)
        t += 0.1
    end
    return _G.FarmState
end

local state = waitForState()
if not state then
    warn("FarmGUI: FarmState never appeared")
    return
end

