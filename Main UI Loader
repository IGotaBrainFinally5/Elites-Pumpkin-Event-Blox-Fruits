    pumpkinFarm.lastDistance = nil
    pumpkinFarm.lastY = nil
    pumpkinFarm.lastDy = nil
    pumpkinFarm.oscillationCount = 0
    pumpkinFarm.attackStartedAt = nil
end
local function setTarget(p, r, dist, reason)
    pumpkinFarm.currentPumpkin = p
    pumpkinFarm.currentRoot = r
    resetStuckTracking()
    pumpkinFarm.flyTarget = computeSafeFlyTarget(r.Position)
    pumpkinFarm.state = "MOVING"
