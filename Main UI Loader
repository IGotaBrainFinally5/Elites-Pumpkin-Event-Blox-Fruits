end
local function blacklistTarget(reason)
    local p = pumpkinFarm.currentPumpkin
    if p then
        pumpkinFarm.blacklist[p] = os.clock() + CONFIG.BLACKLIST_DURATION
        addLog("PUMPKIN", string.format("Blacklist %s (%s)", tostring(p.Name), reason))
    end
    pumpkinFarm.currentPumpkin = nil
    pumpkinFarm.currentRoot = nil
    pumpkinFarm.flyTarget = nil
    pumpkinFarm.weaponEquippedFor = nil
    resetStuckTracking()
