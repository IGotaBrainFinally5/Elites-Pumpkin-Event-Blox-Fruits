-- CANDY CORN
readCandyCorn = function()
    local best, source
    for k, v in pairs(player:GetAttributes()) do
        if tostring(k):lower():find("candy", 1, true) and type(v) == "number" then
            if not best or v > best then best, source = v, "attr." .. tostring(k) end
        end
    end
    local ls = player:FindFirstChild("leaderstats")
    if ls then
        for _, c in ipairs(ls:GetChildren()) do
            if c:IsA("ValueBase") and type(c.Value) == "number" and c.Name:lower():find("candy", 1, true) then
                if not best or c.Value > best then best, source = c.Value, "leaderstats." .. c.Name end
            end
        end
    end
    return best, source
end
checkCandyCornChange = function()
    local current, source = readCandyCorn()
    if current == nil then return end
    stats.currentCandyCorn = current
    stats.candyCornSource = source
    if stats.lastCandyCorn ~= nil and current > stats.lastCandyCorn then
        local delta = current - stats.lastCandyCorn
        local now = os.clock()
        local tag
        if lastTotInteractionAt and now - lastTotInteractionAt < 3 then
            stats.totCandyCorn = stats.totCandyCorn + delta; tag = "TOT"
        elseif pumpkinFarm.lastKillTime and now - pumpkinFarm.lastKillTime < 3 then tag = "FARM"
        else tag = "CC" end
        addLog(tag, "Candy Corn +" .. delta .. " (" .. tag .. ")")
    end
    stats.lastCandyCorn = current
end

-- FRUIT SCAN
seedExistingFruits = function()
    if fruitSeeded then return end
    for _, cont in ipairs({ player:FindFirstChild("Backpack"), player.Character }) do
        if cont then
            for _, child in ipairs(cont:GetChildren()) do
                if child:IsA("Tool") and looksLikeFruit(child.Name) then
                    observedFruitTools[child] = { name = child.Name, tracked = false, seenAt = os.clock() }
                end
            end
        end
    end
    fruitSeeded = true
    warn("[EHF] Seeded pre-existing fruits (not tracked as gacha).")
end
local function scanForNewFruits()
    if not fruitSeeded then seedExistingFruits() end
    local present = {}
    for _, cont in ipairs({ player:FindFirstChild("Backpack"), player.Character }) do
        if cont then
            for _, child in ipairs(cont:GetChildren()) do
                if child:IsA("Tool") and looksLikeFruit(child.Name) then
                    present[child] = child.Name
                    if not observedFruitTools[child] then
                        if gacha.pendingRollWindowUntil and os.clock() < gacha.pendingRollWindowUntil then
                            local h = fruitHistory[child.Name]
                            if not h then h = { count = 0, status = "inventory", lastSeen = os.clock() }; fruitHistory[child.Name] = h end
                            h.count = h.count + 1
                            h.status = "inventory"
                            h.lastSeen = os.clock()
                            observedFruitTools[child] = { name = child.Name, tracked = true, seenAt = os.clock() }
                            gacha.pendingRollWindowUntil = nil
                            addLog("FRUIT", "Gacha roll confirmed: " .. child.Name .. " (×" .. h.count .. ")")
                            fruitDirty = true
                            recordGachaRoll("fruit: " .. child.Name)
                        else
                            observedFruitTools[child] = { name = child.Name, tracked = false, seenAt = os.clock() }
                        end
                    end
                end
            end
        end
    end
    for tool, meta in pairs(observedFruitTools) do
        if not present[tool] then
            observedFruitTools[tool] = nil
            if meta.tracked then
                local h = fruitHistory[meta.name]
                if h then
                    local stored = lastStoreAttempt and lastStoreAttempt.fruit == meta.name and (os.clock() - lastStoreAttempt.time < 10)
                    local died = recentDeathAt and (os.clock() - recentDeathAt < 15)
                    if stored then h.status = "stored"; addLog("FRUIT", "Stored: " .. meta.name)
                    elseif died then h.status = "lost"; addLog("FRUIT", "Lost on death (inferred): " .. meta.name)
                    else h.status = "unknown"; addLog("FRUIT", "Disappeared: " .. meta.name) end
                    fruitDirty = true
                end
            end
        end
    end
end

