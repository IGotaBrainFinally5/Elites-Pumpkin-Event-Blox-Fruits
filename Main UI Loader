end

-- GACHA WINDOW
updateCountdownLabels = function()
    if not gachaTimerLabel then return end
    if gacha.nextResetAt then
        local remain = math.max(0, gacha.nextResetAt - os.clock())
        gachaTimerLabel.Text = string.format("%02d:%02d", math.floor(remain/60), math.floor(remain%60))
        gachaTimerLabel.TextColor3 = THEME.Yellow
        gachaStatusLabel.Text = string.format("Cooldown (%d/%d rolls used)", gacha.rollsUsed, CONFIG.GACHA_MAX_ROLLS)
        gachaStatusLabel.TextColor3 = THEME.Yellow
        if remain <= 0 then
            gacha.rollsUsed = 0
            gacha.nextResetAt = nil
            addLog("GACHA", "1h window expired — 2 rolls available again.")
            updateCountdownLabels()
        end
    else
        gachaTimerLabel.Text = "READY"
        gachaTimerLabel.TextColor3 = THEME.Green
        gachaStatusLabel.Text = string.format("%d/%d rolls used — %d left", gacha.rollsUsed, CONFIG.GACHA_MAX_ROLLS, CONFIG.GACHA_MAX_ROLLS - gacha.rollsUsed)
        gachaStatusLabel.TextColor3 = THEME.Green
    end
end
recordGachaRoll = function(source)
    gacha.rollsUsed = gacha.rollsUsed + 1
    addLog("GACHA", string.format("Roll counted (%d/%d) — %s", gacha.rollsUsed, CONFIG.GACHA_MAX_ROLLS, tostring(source)))
    if gacha.rollsUsed >= CONFIG.GACHA_MAX_ROLLS and not gacha.nextResetAt then
        gacha.nextResetAt = os.clock() + CONFIG.GACHA_WINDOW_SECONDS
        addLog("GACHA", "2 rolls used. Starting 1h countdown.")
    end
    updateCountdownLabels()
end
resetGachaWindow = function(reason)
    gacha.rollsUsed = 0
    gacha.nextResetAt = nil
    gacha.pendingRollWindowUntil = nil
    addLog("GACHA", "Window reset. (" .. tostring(reason or "manual") .. ")")
    updateCountdownLabels()
end

