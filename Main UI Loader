-- =========================================================
readCandyCorn = function()
    local best, source
    for k, v in pairs(player:GetAttributes()) do
        local ks = tostring(k):lower()
        if ks:find("candy", 1, true) and type(v) == "number" then
            if not best or v > best then
                best, source = v, "attr." .. tostring(k)
            end
        end
    end
    local ls = player:FindFirstChild("leaderstats")
    if ls then
        for _, c in ipairs(ls:GetChildren()) do
            if c:IsA("ValueBase") and type(c.Value) == "number" and c.Name:lower():find("candy", 1, true) then
                if not best or c.Value > best then
                    best, source = c.Value, "leaderstats." .. c.Name
                end
            end
        end
    end
    return best, source
end

checkCandyCornChange = function()
    local current, source = readCandyCorn()
    if current == nil then return end
    stats.currentCandyCorn = current
    stats.candyCornSource = source
    if stats.lastCandyCorn ~= nil and current > stats.lastCandyCorn then
        local delta = current - stats.lastCandyCorn
        local now = os.clock()
        local source_tag
        if lastTotInteractionAt and now - lastTotInteractionAt < 3 then
            stats.totCandyCorn = stats.totCandyCorn + delta
            source_tag = "TOT"
        elseif pumpkinFarm.lastKillTime and now - pumpkinFarm.lastKillTime < 3 then
            source_tag = "FARM"
        else
            source_tag = "CC"
        end
        addLog(source_tag, "Candy Corn +" .. delta .. " (source: " .. source_tag .. ", now " .. current .. ")")
        if refreshStatsTab then refreshStatsTab() end
    end
    stats.lastCandyCorn = current
end

-- =========================================================
-- FRUIT SCAN
-- =========================================================
local function scanForNewFruits()
    local present = {}
    for _, cont in ipairs({ player:FindFirstChild("Backpack"), player.Character }) do
        if cont then
            for _, child in ipairs(cont:GetChildren()) do
                if child:IsA("Tool") and looksLikeFruit(child.Name) then
                    present[child] = child.Name
                    if not observedFruitTools[child] then
                        observedFruitTools[child] = { name = child.Name, seenAt = os.clock() }
                        local h = fruitHistory[child.Name]
                        if not h then
                            h = { count = 0, status = "inventory", lastSeen = os.clock() }
                            fruitHistory[child.Name] = h
                        end
                        h.status = "inventory"
                        h.lastSeen = os.clock()
                        local viaGacha = gacha.lastPurchaseAttemptAt and (os.clock() - gacha.lastPurchaseAttemptAt < 30)
                        if viaGacha then
                            h.count = h.count + 1
                            addLog("FRUIT", "Rolled (gacha): " .. child.Name .. " (×" .. h.count .. ")")
                            if gacha.lastConfirmedRollAt == nil or os.clock() - gacha.lastConfirmedRollAt > 1 then
                                gacha.lastConfirmedRollAt = os.clock()
                                updateCountdownLabels()
                            end
                        else
                            addLog("FRUIT", "Appeared: " .. child.Name .. " (source unknown)")
                        end
                        if refreshStatsTab then refreshStatsTab() end
                    end
                end
            end
        end
    end
    -- Detect disappeared fruit tools
    for tool, meta in pairs(observedFruitTools) do
        if not present[tool] then
            local name = meta.name
            observedFruitTools[tool] = nil
            local h = fruitHistory[name]
            if h then
                local stored = lastStoreAttempt and lastStoreAttempt.fruit == name and (os.clock() - lastStoreAttempt.time < 10)
                local died = recentDeathAt and (os.clock() - recentDeathAt < 15)
                if stored then
                    h.status = "stored"
                    addLog("FRUIT", "Confirmed stored: " .. name)
                elseif died then
                    h.status = "lost"
                    addLog("FRUIT", "Lost on death (inferred, no store call): " .. name)
                else
                    h.status = "unknown"
                    addLog("FRUIT", "Disappeared: " .. name .. " (unknown: stored, dropped, or traded?)")
                end
                if refreshStatsTab then refreshStatsTab() end
            end
        end
    end
end

-- =========================================================
-- GACHA RESPONSE PARSER
-- =========================================================
local function parseGachaResponse(res)
    if type(res) ~= "table" then return end
    local candidates = {}
    local function walk(t, prefix)
        for k, v in pairs(t) do
            local key = prefix and (prefix .. "." .. tostring(k)) or tostring(k)
            if type(v) == "number" then
                local kl = tostring(k):lower()
                if kl:find("cool", 1, true) or kl:find("next", 1, true) or kl:find("reset", 1, true) or kl:find("timeleft", 1, true) then
                    table.insert(candidates, { key = key, value = v })
                end
            elseif type(v) == "table" then
                walk(v, key)
            end
        end
    end
    pcall(function() walk(res, "") end)
    if #candidates > 0 then
        local best = candidates[1]
        addLog("GACHA", "Cooldown field candidate: " .. best.key .. " = " .. tostring(best.value))
        if best.value > 0 and best.value < 86400 then
            gacha.cooldownSeconds = best.value
            addLog("GACHA", "Using parsed cooldown: " .. best.value .. "s")
        end
    end
end

