-- =========================================================
-- WATER HELPERS
-- =========================================================
local function getWaterHeightAt(x, z)
    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    local char = player.Character
    if char then params.FilterDescendantsInstances = { char } end
    params.IgnoreWater = false
    params.RespectCanCollide = false

    local origin = Vector3.new(x, 2000, z)
    local dir = Vector3.new(0, -4000, 0)
    local ok, result = pcall(function() return Workspace:Raycast(origin, dir, params) end)
    if not ok or not result then return nil end

    local inst = result.Instance
    local mat = result.Material
    local isWater = (mat == Enum.Material.Water)
    if not isWater and inst then
        local n = inst.Name:lower()
        if n:find("water", 1, true) or n:find("ocean", 1, true) then
            isWater = true
        end
    end
    if isWater then return result.Position.Y end
    return nil, result.Position.Y
end

local function computeSafeFlyTarget(targetPos)
    local waterY, groundY = getWaterHeightAt(targetPos.X, targetPos.Z)
    local safeY = targetPos.Y
    if waterY then
        local minY = waterY + CONFIG.MIN_HEIGHT_ABOVE_WATER
        if safeY < minY then safeY = minY end
    elseif groundY then
        local minY = groundY + 3
        if safeY < minY then safeY = minY end
    end
    return Vector3.new(targetPos.X, safeY, targetPos.Z)
end

-- =========================================================
-- WEAPON HELPERS
-- =========================================================
local MELEE_STYLES = {
    "combat", "dark step", "electric", "water kung fu",
    "dragon breath", "superhuman", "death step",
    "sharkman karate", "electric claw", "dragon talon",
    "godhuman", "sanguine art",
}

local function isMeleeStyle(name)
    local n = tostring(name):lower()
    for _, s in ipairs(MELEE_STYLES) do
        if n:find(s, 1, true) then return true end
    end
    return false
end

local function looksLikeFruitTool(name)
    return tostring(name):find("%-") ~= nil
end

local function equipWeaponOfCategory(category)
    local char = player.Character
    if not char then return nil end
    local humanoid = char:FindFirstChildOfClass("Humanoid")
    if not humanoid then return nil end

    local current = char:FindFirstChildOfClass("Tool")
    if current then
        local isMelee = isMeleeStyle(current.Name)
        if (category == "Melee" and isMelee) or (category == "Sword" and not isMelee and not looksLikeFruitTool(current.Name)) then
            return current
        end
    end

    local backpack = player:FindFirstChild("Backpack")
    if not backpack then return nil end

    for _, tool in ipairs(backpack:GetChildren()) do
        if tool:IsA("Tool") then
            local isMelee = isMeleeStyle(tool.Name)
            local isFruit = looksLikeFruitTool(tool.Name)
            local match = false
            if category == "Melee" then
                match = isMelee
            elseif category == "Sword" then
                match = (not isMelee) and (not isFruit)
            end
            if match then
                pcall(function() humanoid:EquipTool(tool) end)
                return tool
            end
        end
    end
    return nil
end

